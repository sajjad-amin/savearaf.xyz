---
export const prerender = false;

const session = Astro.locals.session;
const user = Astro.locals.user;

// If accessed directly without an active session, redirect to home
if (!session || !user) {
  return Astro.redirect('/');
}

// If user is already onboarded, redirect to home
if (user.is_onboarded) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>যোগাযোগের তথ্য প্রদান করুন - Save Araf</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8 antialiased">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
      <!-- Logo -->
      <div class="flex justify-center">
        <a href="/" class="flex items-center gap-2">
          <img src="/logo.png" alt="Save Araf Logo" class="w-16 h-16 rounded-2xl shadow-md object-contain" />
        </a>
      </div>

      <h1 class="mt-6 text-center text-2xl font-extrabold text-gray-900 tracking-tight">
        প্রোফাইল সম্পন্ন করুন
      </h1>
      <p class="mt-1 text-center text-sm text-gray-600">
        Complete your contact profile for emergency coordination
      </p>

      {user.image && (
        <div class="mt-4 flex items-center justify-center gap-3 bg-white py-2 px-4 rounded-full shadow-xs border border-gray-200 w-fit mx-auto">
          <img src={user.image} alt={user.name || 'User'} class="w-7 h-7 rounded-full object-cover" />
          <span class="text-xs font-medium text-gray-700">{user.name || user.email}</span>
        </div>
      )}
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-lg">
      <div class="bg-white py-8 px-6 shadow-sm rounded-3xl border border-gray-200 sm:px-10">
        <!-- Bilingual Guidance Notice -->
        <div class="rounded-2xl bg-rose-50 p-4 border border-rose-100 mb-6 text-sm">
          <p class="font-semibold text-rose-900 mb-1">
            📱 ফোন নম্বর প্রদান জরুরি:
          </p>
          <p class="text-rose-800 leading-relaxed text-xs sm:text-sm">
            আরাফের জরুরি রক্তের প্লাটিলেট (SDP) বা হোল ব্লাড সমন্বয়ের জন্য আপনার সচল ফোন নম্বর প্রয়োজন। আমরা <strong>হোয়াটসঅ্যাপ (WhatsApp)</strong> সংযুক্ত নম্বর দেওয়ার জন্য উৎসাহিত করছি যাতে যেকোনো জরুরি প্রয়োজনে দ্রুত যোগাযোগ করা যায়, তবে <strong>যেকোনো সক্রিয় ও বৈধ মোবাইল নম্বর পুরোপুরি গ্রহণযোগ্য</strong>।
          </p>
          <hr class="my-2.5 border-rose-200" />
          <p class="text-rose-700 leading-relaxed text-xs">
            <em>English: We require an active phone number to coordinate urgent platelet/blood transfusions for Araf. A WhatsApp-connected number is strongly encouraged for rapid coordination, but any valid, active phone number is completely acceptable.</em>
          </p>
        </div>

        <!-- Onboarding Form -->
        <form method="POST" action="/api/onboard" class="space-y-6">
          <div>
            <label for="phone" class="block text-sm font-semibold text-gray-900 mb-1.5">
              মোবাইল / হোয়াটসঅ্যাপ নম্বর <span class="text-rose-600">*</span>
            </label>
            <div class="relative rounded-xl shadow-xs">
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                autocomplete="tel"
                placeholder="যেমন: 017XXXXXXXX অথবা +88017XXXXXXXX"
                class="block w-full rounded-xl border border-gray-300 py-3 px-4 text-gray-900 placeholder-gray-400 focus:border-rose-500 focus:ring-rose-500 text-base transition sm:text-sm"
              />
            </div>
            <p class="mt-2 text-xs text-gray-500 flex items-center gap-1">
              <span>🔒</span> আপনার তথ্যটি কেবল রোগী সমন্বয়কারী দলের কাছে থাকবে এবং তৃতীয় পক্ষের সাথে শেয়ার করা হবে না।
            </p>
          </div>

          <div>
            <button
              type="submit"
              class="w-full flex justify-center py-3.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-rose-600 hover:bg-rose-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-rose-500 transition cursor-pointer"
            >
              সংরক্ষণ করুন ও এগিয়ে যান (Save & Continue) →
            </button>
          </div>
        </form>

        <!-- Account Switcher / Sign Out -->
        <div class="mt-6 pt-5 border-t border-gray-200 text-center">
          <p class="text-xs text-gray-500">
            ভুল অ্যাকাউন্টে লগইন করেছেন?
            <a
              href="/api/auth/signout"
              class="text-rose-600 hover:text-rose-700 font-semibold underline ml-1"
            >
              লগআউট করুন (Sign Out)
            </a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
