---
export const prerender = false;

import { db } from '@/db';
import { users } from '@/db/schema';
import { eq } from 'drizzle-orm';

const session = Astro.locals.session;
const user = Astro.locals.user;

// Only logged in users can access profile settings
if (!session || !user) {
  return Astro.redirect('/api/auth/signin');
}

// Fetch latest user data from DB
let currentName = user.name || '';
let currentEmail = user.email || '';
let currentPhone = user.phone || '';
let currentImage = user.image;
let currentRole = user.role || 'user';

try {
  const [dbUser] = await db
    .select({
      id: users.id,
      name: users.name,
      email: users.email,
      phone: users.phone,
      image: users.image,
      role: users.role,
    })
    .from(users)
    .where(eq(users.id, user.id))
    .limit(1);

  if (dbUser) {
    currentName = dbUser.name || currentName;
    currentEmail = dbUser.email || currentEmail;
    currentPhone = dbUser.phone || currentPhone;
    currentImage = dbUser.image || currentImage;
    currentRole = dbUser.role || currentRole;
  }
} catch (error) {
  console.error('Error fetching user profile from database:', error);
}

const isUpdated = Astro.url.searchParams.get('updated') === 'true';
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>প্রোফাইল সেটিংস - Save Araf</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased">
    <!-- Header -->
    <header class="border-b border-gray-200 bg-white sticky top-0 z-10 shadow-xs">
      <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-bold text-lg text-rose-600 hover:text-rose-700">
          <img src="/logo.png" alt="Save Araf Logo" class="w-8 h-8 rounded-lg object-contain" />
          <span>Save Araf</span>
        </a>
        <a href="/" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition">
          ← মূল পাতায় ফিরুন (Back to Home)
        </a>
      </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-3xl mx-auto px-4 py-10 flex-1 w-full">
      <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900">
            প্রোফাইল সেটিংস (Profile Settings)
          </h1>
          <p class="text-sm text-gray-500 mt-1">
            আপনার নাম এবং যোগাযোগের ফোন নম্বর পরিচালনা করুন
          </p>
        </div>

        {currentImage && (
          <div class="flex items-center gap-3 bg-white p-2 pr-4 rounded-full border border-gray-200 shadow-xs w-fit">
            <img src={currentImage} alt={currentName} class="w-10 h-10 rounded-full object-cover" />
            <div class="text-left">
              <span class="block text-xs font-bold text-gray-900">{currentName}</span>
              <span class="block text-[11px] text-gray-500 capitalize">{currentRole}</span>
            </div>
          </div>
        )}
      </div>

      <!-- Success Notification Banner -->
      {isUpdated && (
        <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3">
          <span class="text-lg">✅</span>
          <span>আপনার প্রোফাইল তথ্য সফলভাবে হালনাগাদ করা হয়েছে (Profile updated successfully)।</span>
        </div>
      )}

      <!-- Profile Update Form Card -->
      <section class="bg-white rounded-3xl border border-gray-200 shadow-xs p-6 sm:p-8 mb-8">
        <h2 class="text-lg font-bold text-gray-900 mb-6 pb-3 border-b border-gray-100 flex items-center gap-2">
          <span>👤</span>
          <span>ব্যক্তিগত বিবরণ (Personal Details)</span>
        </h2>

        <form method="POST" action="/api/profile/update" class="space-y-6">
          <!-- Full Name -->
          <div>
            <label for="name" class="block text-sm font-semibold text-gray-800 mb-1.5">
              পূর্ণ নাম (Full Name) <span class="text-rose-600">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              value={currentName}
              required
              class="block w-full rounded-xl border border-gray-300 py-2.5 px-4 text-gray-900 placeholder-gray-400 focus:border-rose-500 focus:ring-rose-500 text-sm transition"
            />
          </div>

          <!-- Email (Read-only) -->
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-800 mb-1.5">
              ইমেইল ঠিকানা (Email Address)
            </label>
            <input
              type="email"
              id="email"
              value={currentEmail}
              disabled
              class="block w-full rounded-xl border border-gray-200 bg-gray-50 py-2.5 px-4 text-gray-500 cursor-not-allowed text-sm"
            />
            <p class="mt-1.5 text-xs text-gray-400">
              🔒 গুগল অ্যাকাউন্ট দ্বারা সুরক্ষিত হওয়ায় ইমেইল পরিবর্তনযোগ্য নয় (Managed by Google OAuth).
            </p>
          </div>

          <!-- Phone Number -->
          <div>
            <label for="phone" class="block text-sm font-semibold text-gray-800 mb-1.5">
              মোবাইল / হোয়াটসঅ্যাপ নম্বর (Phone / WhatsApp) <span class="text-rose-600">*</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              value={currentPhone}
              required
              placeholder="017XXXXXXXX বা +88017XXXXXXXX"
              class="block w-full rounded-xl border border-gray-300 py-2.5 px-4 text-gray-900 placeholder-gray-400 focus:border-rose-500 focus:ring-rose-500 text-sm transition"
            />
            <p class="mt-1.5 text-xs text-gray-500">
              জরুরি রক্তদান বা প্লাটিলেট সমন্বয়ের সুবিধার্থে হোয়াটসঅ্যাপ সংযুক্ত নম্বর উৎসাহিত করা হয়।
            </p>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              class="inline-flex justify-center py-2.5 px-6 border border-transparent rounded-xl shadow-xs text-sm font-bold text-white bg-rose-600 hover:bg-rose-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-rose-500 transition cursor-pointer"
            >
              পরিবর্তন সংরক্ষণ করুন (Save Changes)
            </button>
          </div>
        </form>
      </section>

      <!-- Danger Zone: Delete Account Card -->
      <section class="bg-rose-50/50 rounded-3xl border border-rose-200 shadow-xs p-6 sm:p-8">
        <h2 class="text-lg font-bold text-rose-900 mb-2 flex items-center gap-2">
          <span>⚠️</span>
          <span>বিপদজনক এলাকা (Danger Zone)</span>
        </h2>
        <p class="text-xs sm:text-sm text-rose-800 leading-relaxed mb-6">
          আপনি যদি এই প্ল্যাটফর্ম থেকে আপনার অ্যাকাউন্ট অপসারণ করতে চান, তবে নিচে "অ্যাকাউন্ট মুছে ফেলুন" বাটনে চাপুন। 
          আপনার নাম <strong>"Anonymous Donor"</strong> হিসেবে পরিবর্তিত হবে এবং আপনার ফোন নম্বর ও ছবি স্থায়ীভাবে মুছে ফেলা হবে। 
          আপনার পূর্ববর্তী রক্তদানের রেকর্ড রোগীর চিকিৎসা তথ্যের স্বার্থে সম্পূর্ণ বেনামী অবস্থায় ডাটাবেজে সংরক্ষিত থাকবে।
        </p>

        <form
          method="POST"
          action="/api/profile/delete"
          onsubmit="return confirm('আপনি কি নিশ্চিত যে আপনার অ্যাকাউন্টটি স্থায়ীভাবে অপসারণ করতে চান? এই প্রক্রিয়া সম্পন্ন হলে আপনার ব্যক্তিগত তথ্য মুছে যাবে।');"
        >
          <button
            type="submit"
            class="inline-flex items-center justify-center py-2.5 px-5 rounded-xl border border-rose-300 bg-white hover:bg-rose-600 text-rose-700 hover:text-white font-bold text-sm shadow-xs transition duration-150 cursor-pointer"
          >
            অ্যাকাউন্ট মুছে ফেলুন (Delete Account)
          </button>
        </form>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 bg-white py-6 text-center text-xs text-gray-500">
      <p>&copy; 2026 Save Araf Campaign. All rights reserved.</p>
    </footer>
  </body>
</html>
