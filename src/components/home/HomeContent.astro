    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={isBn ? 'Save Araf | বাঁচতে চায় ক্যানসার আক্রান্ত ১৭ বছরের কলেজছাত্র আরাফ' : 'Save Araf | Help Araf Fight Acute Myeloid Leukemia'} />
    <meta
      property="og:description"
      content={isBn
        ? 'আরাফের শরীরে প্রাণঘাতী ব্লাড ক্যানসার (AML)। পিতা মে মাস থেকে কর্মহীন। ঢাকা মেডিকেলে চলছে কেমো ও প্লাটিলেট। আপনার সামান্য অনুদান বা দোয়াই পারে ছেলেটাকে বাঁচাতে।'
        : '17-year-old Araf is battling blood cancer (AML) at DMCH. His father is unemployed. Urgent appeal for treatment support.'}
    />
    <meta property="og:image" content={heroHospitalImg} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={isBn ? 'Save Araf | ১৭ বছরের আরাফের জীবন বাঁচাতে এগিয়ে আসুন' : 'Save Araf | Emergency Medical Appeal for 17-Year-Old Araf'} />
