---
interface Props {
  lang: 'bn' | 'en';
}

const { lang } = Astro.props;
const isBn = lang === 'bn';

import Navbar from '@/components/common/Navbar.astro';
import Footer from '@/components/common/Footer.astro';

const isDeleted = Astro.url.searchParams.get('deleted') === 'true';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isBn ? 'আরাফকে বাঁচান - Save Araf' : 'Save Araf - Emergency Appeal'}</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased">
    <!-- Revamped Global Navbar -->
    <Navbar lang={lang} />

    <!-- Main Content Area (Cleaned temporarily for upcoming Phase 5 campaign content) -->
    <main class="max-w-4xl mx-auto px-4 py-12 flex-1 w-full">
      {isDeleted && (
        <div class="mb-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm flex items-center gap-2">
          <span>ℹ️</span>
          <span>
            {isBn
              ? 'আপনার অ্যাকাউন্ট ও ব্যক্তিগত তথ্য সফলভাবে অপসারণ করা হয়েছে।'
              : 'Your account and personal data have been successfully deleted.'}
          </span>
        </div>
      )}
    </main>

    <!-- Global Footer -->
    <Footer lang={lang} />
  </body>
</html>
