          <span>{isBn ? '৪০ লাখের হিসাব' : '40L Target'}</span>
        </a>
        <a
          href="#media-report"
          class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 hover:text-rose-600 hover:bg-rose-50 border border-gray-200/60 hover:border-rose-200 transition whitespace-nowrap flex items-center gap-1 shrink-0"
        >
          <i data-lucide="newspaper" class="w-3.5 h-3.5"></i>
          <span>{isBn ? 'পত্রিকায় সংবাদ' : 'Media Coverage'}</span>
        </a>
        <a
          href="#budget"
          class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 hover:text-rose-600 hover:bg-rose-50 border border-gray-200/60 hover:border-rose-200 transition whitespace-nowrap flex items-center gap-1 shrink-0"
        >
          <i data-lucide="pie-chart" class="w-3.5 h-3.5"></i>
          <span>{isBn ? 'তহবিল হিসাব' : 'Financials'}</span>
        </a>
        <a
          href="#donate-section"
          class="px-3 py-1.5 rounded-full text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 shadow-2xs transition whitespace-nowrap flex items-center gap-1 shrink-0"
        >
          <i data-lucide="heart" class="w-3.5 h-3.5 fill-white"></i>
          <span>{isBn ? 'সাহায্য পাঠান' : 'Donate Funds'}</span>
        </a>
        <a
          href={donateBloodUrl}
          class="px-3 py-1.5 rounded-full text-xs font-bold text-rose-700 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition whitespace-nowrap flex items-center gap-1 shrink-0"
        >
          <i data-lucide="droplets" class="w-3.5 h-3.5 fill-rose-600 text-rose-600"></i>
          <span>{isBn ? 'রক্তদাতা' : 'Blood Donors'}</span>
        </a>
        <a
          href="#story"
          class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 hover:text-rose-600 hover:bg-rose-50 border border-gray-200/60 hover:border-rose-200 transition whitespace-nowrap flex items-center gap-1 shrink-0"
        >
          <i data-lucide="message-square" class="w-3.5 h-3.5"></i>
          <span>{isBn ? 'পরিবারের আবেদন' : 'Family Plea'}</span>
        </a>
