                ? 'আরাফের চিকিৎসাসংক্রান্ত তথ্য ও অনুদানের বিষয়ে বিস্তারিত জানতে তার চাচাতো ভাইয়ের সাথে সরাসরি যোগাযোগ করুন:'
                : 'For any verification or queries, please feel free to reach out to Araf’s cousin directly:'}
            </p>
            <div class="inline-flex items-center gap-3 pt-1">
              <a
                href="tel:01515616728"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gray-900 text-white font-mono font-bold text-sm hover:bg-gray-800 transition"
              >
                <span aria-hidden="true">📞</span>
                <span>01515616728</span>
              </a>
              <span class="text-xs text-gray-600 font-semibold">{isBn ? '(শেখ মাহমুদ ইসলাম মিজু - চাচাতো ভাই)' : '(Sheikh Mahmud Islam Mizu - Cousin)'}</span>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Lightbox Modal for Report Previews -->
    <div
      id="lightbox-modal"
      class="fixed inset-0 bg-gray-900/80 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden"
      role="dialog"
      aria-modal="true"
    >
      <div class="relative bg-white rounded-3xl max-w-3xl w-full p-4 sm:p-6 shadow-2xl max-h-[92vh] flex flex-col">
        <div class="flex items-center justify-between pb-3 border-b border-gray-100">
          <span class="text-xs font-bold text-gray-600 uppercase tracking-wider">{isBn ? 'মেডিকেল প্রমাণপত্র' : 'Medical Report Preview'}</span>
          <button
            type="button"
            id="close-lightbox-btn"
            aria-label={isBn ? 'রিপোর্ট প্রিভিউ বন্ধ করুন' : 'Close report preview'}
            class="text-gray-500 hover:text-gray-700 text-xl font-bold w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center transition cursor-pointer"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>
        <div class="mt-4 flex-1 overflow-auto flex items-center justify-center">
          <img
            id="lightbox-img"
            src=""
            alt={isBn ? 'মেডিকেল রিপোর্টের পূর্ণাঙ্গ দৃশ্য' : 'Medical Report Full View'}
            class="max-h-[75vh] w-auto rounded-xl object-contain shadow-xs"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <!-- Client-side Interactive Scripts (Copy to clipboard & Lightbox) -->
    <script is:inline>
      (() => {
        // 1. One-click Copy Handler
        document.querySelectorAll('.copy-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const textToCopy = btn.getAttribute('data-copy');
            if (!textToCopy) return;

            try {
              await navigator.clipboard.writeText(textToCopy);
              const textSpan = btn.querySelector('.btn-text');
              const originalText = textSpan ? textSpan.textContent : '';
              if (textSpan) textSpan.textContent = 'কপি হয়েছে! ✓';
              btn.classList.add('bg-emerald-600', 'text-white');

              setTimeout(() => {
                if (textSpan) textSpan.textContent = originalText;
                btn.classList.remove('bg-emerald-600');
              }, 2000);
            } catch (err) {
              console.error('Failed to copy:', err);
            }
          });
        });

        // 2. Report Lightbox Handler
        const modal = document.getElementById('lightbox-modal');
        const modalImg = document.getElementById('lightbox-img');
        const closeBtn = document.getElementById('close-lightbox-btn');

        if (modal && modalImg && closeBtn) {
          document.querySelectorAll('.report-preview').forEach((trigger) => {
            trigger.addEventListener('click', (e) => {
              const src = trigger.getAttribute('data-src');
              if (src) {
                modalImg.src = src;
                modal.classList.remove('hidden');
              }
            });
          });

          const closeModal = () => {
            modal.classList.add('hidden');
            modalImg.src = '';
          };

          closeBtn.addEventListener('click', closeModal);
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
          });
          window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
              closeModal();
            }
          });
        }
      })();
    </script>

    <!-- Global Footer -->
    <Footer lang={lang} />
  </body>
</html>
