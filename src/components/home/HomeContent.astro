            <!-- Current Status Highlights Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 py-1">
              <div class="bg-white p-3 rounded-2xl border border-gray-200 shadow-2xs">
                <span class="text-[11px] text-gray-500 block">{isBn ? 'বয়স ও শিক্ষা' : 'Age & College'}</span>
                <span class="text-sm font-bold text-gray-800">{isBn ? '১৭ বছর (পলিটেকনিক)' : '17 yrs (Polytechnic)'}</span>
              </div>
              <div class="bg-white p-3 rounded-2xl border border-gray-200 shadow-2xs">
                <span class="text-[11px] text-gray-500 block">{isBn ? 'রক্তের গ্রুপ' : 'Blood Group'}</span>
                <span class="text-sm font-black text-rose-600">B+ (বি পজিটিভ)</span>
              </div>
              <div class="bg-white p-3 rounded-2xl border border-gray-200 shadow-2xs">
                <span class="text-[11px] text-gray-500 block">{isBn ? 'চিকিৎসা পর্যায়' : 'Treatment Stage'}</span>
