        }
        100% {
          transform: translateX(-50%);
        }
      }
      .animate-marquee {
        display: inline-block;
        white-space: nowrap;
        animation: marquee linear infinite;
      }
    </style>
  </head>

  <body class="bg-[#faf8f5] text-slate-800 antialiased selection:bg-rose-500 selection:text-white">
    <!-- ======================================================== -->
    <!-- TOP EMERGENCY ANNOUNCEMENT BAR                           -->
    <!-- ======================================================== -->
    <aside class="bg-rose-600 text-white text-xs sm:text-sm py-2 px-3 sm:px-4 shadow-2xs relative z-40 overflow-hidden">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
        <!-- Emergency Badge (Left) -->
        <div class="flex items-center gap-2 shrink-0 z-10 bg-rose-600 pr-1">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-black bg-white text-rose-600 uppercase tracking-wider animate-pulse shadow-2xs">
            {isBn ? 'জরুরি অবস্থা' : 'EMERGENCY'}
          </span>
        </div>

        <!-- Emergency Announcement Text (Center) -->
        {enableScrolling ? (
          <div class="overflow-hidden flex-1 relative whitespace-nowrap min-w-0" title={emergencyText}>
            <div
              class="inline-block animate-marquee hover:[animation-play-state:paused] font-medium text-xs sm:text-sm cursor-default"
              style={`animation-duration: ${scrollSpeed}s;`}
            >
              <span class="inline-block mr-16">{emergencyText}</span>
              <span class="inline-block mr-16" aria-hidden="true">{emergencyText}</span>
            </div>
          </div>
        ) : (
          <div class="flex-1 overflow-hidden min-w-0">
            <p class="font-medium text-xs sm:text-sm truncate sm:whitespace-normal">
              {emergencyText}
            </p>
          </div>
        )}

        <!-- Emergency Dial Button (Right) -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0 z-10 bg-rose-600 pl-1">
          <a
            href="tel:01515616728"
            class="inline-flex items-center gap-1 font-bold hover:underline bg-white/15 hover:bg-white/25 px-2.5 py-0.5 rounded transition text-xs whitespace-nowrap"
          >
            <i data-lucide="phone-call" class="w-3.5 h-3.5"></i>
            <span>01515616728</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Global App Header / Navbar -->
    <Navbar lang={lang} />

    <!-- ======================================================== -->
    <!-- REDESIGNED SECONDARY SUB-NAVBAR (MODERN & MOBILE-SCROLL) -->
    <!-- ======================================================== -->
    <nav class="sticky top-[56px] sm:top-[72px] z-20 bg-white/95 backdrop-blur-md border-b border-gray-200/80 shadow-2xs">
      <div class="max-w-7xl mx-auto px-3 sm:px-6 py-2 flex items-center gap-1.5 sm:gap-2 overflow-x-auto no-scrollbar scroll-smooth">
        <a
          href="#overview"
          class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 hover:text-rose-600 hover:bg-rose-50 border border-gray-200/60 hover:border-rose-200 transition whitespace-nowrap flex items-center gap-1 shrink-0"
        >
          <i data-lucide="user" class="w-3.5 h-3.5"></i>
          <span>{isBn ? 'আরাফের অবস্থা' : 'Overview'}</span>
        </a>
        <a
          href="#blood-trajectory"
          class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 hover:text-rose-600 hover:bg-rose-50 border border-gray-200/60 hover:border-rose-200 transition whitespace-nowrap flex items-center gap-1 shrink-0"
        >
          <i data-lucide="activity" class="w-3.5 h-3.5 text-rose-600"></i>
          <span>{isBn ? 'রক্তের রিপোর্ট' : 'Blood Counts'}</span>
