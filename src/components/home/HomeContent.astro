        >
          <i data-lucide="file-check" class="w-3.5 h-3.5"></i>
          <span>{isBn ? 'মেডিকেল রিপোর্ট' : 'Reports'}</span>
        </a>
        <a
          href="#faq"
          class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-700 hover:text-rose-600 hover:bg-rose-50 border border-gray-200/60 hover:border-rose-200 transition whitespace-nowrap flex items-center gap-1 shrink-0"
        >
          <i data-lucide="help-circle" class="w-3.5 h-3.5"></i>
          <span>{isBn ? 'প্রশ্নোত্তর' : 'FAQs'}</span>
        </a>
      </div>
    </nav>

    <!-- Main Content Container -->
    <main class="w-full">
      <!-- Notification Banner if account was deleted -->
      {isDeleted && (
        <div class="max-w-6xl mx-auto px-4 pt-4">
          <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm flex items-center justify-between shadow-2xs">
            <div class="flex items-center gap-2.5">
              <span class="text-xl">ℹ️</span>
              <span>
                {isBn
                  ? 'আপনার অ্যাকাউন্ট ও ব্যক্তিগত তথ্য সফলভাবে অপসারণ করা হয়েছে।'
                  : 'Your account and personal data have been successfully deleted.'}
              </span>
            </div>
            <button
              type="button"
              onclick="this.parentElement.remove()"
              aria-label={isBn ? 'বিজ্ঞপ্তি বন্ধ করুন' : 'Dismiss notification'}
              class="text-amber-800 hover:text-amber-950 text-sm font-bold px-2 py-1 cursor-pointer"
            >
              <span aria-hidden="true">✕</span>
            </button>
          </div>
        </div>
      )}

      <!-- ======================================================== -->
      <!-- SECTION 1: HERO SECTION & ACTUAL HOSPITAL PHOTO          -->
      <!-- ======================================================== -->
      <section id="overview" class="py-8 sm:py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Left: Story & Urgent Callout -->
          <div class="lg:col-span-7 space-y-5">
