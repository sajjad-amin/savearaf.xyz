---
interface Props {
  lang: 'bn' | 'en';
}

const { lang } = Astro.props;
const isBn = lang === 'bn';

import Navbar from '@/components/common/Navbar.astro';
import Footer from '@/components/common/Footer.astro';
import { db } from '@/db';
import { campaignSettings } from '@/db/schema';
import { eq } from 'drizzle-orm';

const isDeleted = Astro.url.searchParams.get('deleted') === 'true';
const donateBloodUrl = isBn ? '/donate-blood' : '/en/donate-blood';

// ----------------------------------------------------
// Dynamic Campaign & Clinical Settings (SSR with fallback)
// ----------------------------------------------------
let settings: typeof campaignSettings.$inferSelect | null = null;
try {
  const [row] = await db
    .select()
    .from(campaignSettings)
    .where(eq(campaignSettings.id, 1))
    .limit(1);
  settings = row || null;
} catch (err) {
  console.error('Failed to load campaign settings from DB in SSR:', err);
}

function toBnDigits(val: number | string): string {
  const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
  return val.toString().replace(/\d/g, (d) => bnDigits[Number(d)]);
}

function toEnDigits(val: string): string {
  const bnToEnMap: Record<string, string> = {
    '০': '0', '১': '1', '২': '2', '৩': '3', '৪': '4',
    '৫': '5', '৬': '6', '৭': '7', '৮': '8', '৯': '9',
  };
  return val.replace(/[০-৯]/g, (d) => bnToEnMap[d] || d);
}

const chemoDay =
  (isBn ? settings?.treatmentPhaseBn : settings?.treatmentPhaseEn) ||
  (isBn ? 'আজ ৩য় দিনের কেমো চলছে' : 'Day 3 of Intensive Chemotherapy');

const dailyText =
  (isBn ? settings?.dailyUpdateTextBn : settings?.dailyUpdateTextEn) ||
  (isBn
    ? 'আজ আরাফের ৩য় দিনের কেমোথেরাপির জটিল চক্র চলছে। সেন্ট্রাল ভেনাস লাইন (সিভি লাইন)-এর মাধ্যমে একটানা উচ্চমাত্রার কেমো এবং ওষুধ চলায় ওর শরীর প্রচণ্ড দুর্বল। রক্তের প্লাটিলেট ও প্রয়োজনীয় সেল বারবার আশঙ্কাজনকভাবে কমে যাচ্ছে। সার্বক্ষণিক B+ হোল ব্লাড ও সিঙ্গেল ডোনার প্লাটিলেট (SDP) ব্যাকআপে রাখা অত্যন্ত জরুরি।'
    : 'Araf is currently on Day 3 of his intensive chemotherapy cycle. Continuous high-dose chemo and medications through his Central Venous (CV) line have made him extremely frail. His blood platelets and essential cells are rapidly falling to critical thresholds. Maintaining an immediate standby of B+ Whole Blood and Single Donor Platelets (SDP) is life-critical.');

const hospitalCabin =
  (isBn ? settings?.hospitalCabinBn : settings?.hospitalCabinEn) ||
  (isBn ? 'ডিএমসিএইচ ১১৪/বি' : 'DMCH Cabin 114/B');

const doctorName =
  (isBn ? settings?.doctorNameBn : settings?.doctorNameEn) ||
  (isBn ? 'ডা. হুমায়রা নাজনীন' : 'Dr. Humayra Nazneen');

const defaultEmergencyBn =
  'হাসপাতাল কেবিন: ডিএমসিএইচ ১১৪/বি • আজ ৩য় দিনের কেমো চলছে • রক্তের গ্রুপ: B+ (বি পজিটিভ) • জরুরি B+ রক্ত ও প্লাটিলেট (SDP) প্রয়োজন';
const defaultEmergencyEn =
  'DMCH Cabin 114/B • Day 3 of Intensive Chemotherapy • Blood Group: B+ (Positive) • Urgent need for B+ Blood & SDP Platelets';

const emergencyText =
  (isBn ? settings?.emergencyTextBn : settings?.emergencyTextEn) ||
  (isBn ? defaultEmergencyBn : defaultEmergencyEn);

const enableScrolling = settings?.enableScrolling ?? false;
const scrollSpeed = settings?.scrollSpeed || 20;

const targetGoal = settings?.fundTarget ? Number(settings.fundTarget) : 4000000; // 40,00,000 BDT
const currentRaised = settings?.fundRaised !== null && settings?.fundRaised !== undefined ? Number(settings.fundRaised) : 137841;
const remainingAmount = Math.max(0, targetGoal - currentRaised);
const progressPercentNum = targetGoal > 0 ? Number(((currentRaised / targetGoal) * 100).toFixed(2)) : 0;
const progressPercent = progressPercentNum.toString();

// Circular progress calculations (Radius 42, circumference ~264)
const circleRadius = 42;
const circleCircumference = 264;
const circleOffset = Math.max(0, circleCircumference - (circleCircumference * (progressPercentNum / 100)));

const fundDate = isBn
  ? '২ নভেম্বর রাত ১২টা পর্যন্ত হিসাব হালনাগাদ করা হয়েছে'
  : 'Audited and updated as of November 2, 12:00 AM';
const newsUrl = 'https://www.shomoyeralo.com/news/393324';
const newsTitle = isBn
  ? '“বাঁচতে চায় ক্যানসার আক্রান্ত ১৭ বছরের আরাফ”'
  : '“17-Year-Old Araf Fights Cancer to Survive”';
const newsSource = isBn
  ? '৩ নভেম্বর ২০২৬ • সময়ের আলো'
  : 'November 3, 2026 • Daily Shomoyer Alo';

// Diagnostic CVC Biomarkers (Localized digits based on active language)
const formatBiomarker = (val: string | null | undefined, fallback: string) => {
  const raw = val || fallback;
  return isBn ? toBnDigits(raw) : toEnDigits(raw);
};

const platelets = formatBiomarker(settings?.platelets, '36,000');
const wbc = formatBiomarker(settings?.wbc, '3,460');
const hb = formatBiomarker(settings?.hb, '7.6');
const blast = formatBiomarker(settings?.blast, '90%');
const creat = formatBiomarker(settings?.creatinine, '0.2');
const uric = formatBiomarker(settings?.uricAcid, '4.8');
const alt = formatBiomarker(settings?.alt, '14.83');
const anc = formatBiomarker(settings?.anc, '1,800');

// Semantic image paths in public/campaign/
const heroHospitalImg = '/campaign/araf-hospital-bed.jpg';
const cvcReportImg = '/campaign/cvc-blood-report.jpg';
const dmcAdmissionImg = '/campaign/dmc-hospital-admission.jpg';
const banglaQrImg = '/campaign/bkash-bangla-qr.jpg';
const cityTouchQrImg = '/campaign/citytouch-bank-qr.jpg';
const newsClippingImg = '/campaign/shomoyer-alo-newspaper-report.jpg';
const campaignLogoImg = '/campaign/save-araf-campaign-logo.jpg';
const medicalReportsPdf = '/campaign/araf-medical-reports.pdf';

function formatTaka(amount: number): string {
  if (isBn) {
    return '৳ ' + toBnDigits(amount.toLocaleString('en-IN'));
  }
  return '৳ ' + amount.toLocaleString('en-US');
}

const raisedDisplay = formatTaka(currentRaised);
const targetDisplay = formatTaka(targetGoal);
const remainingDisplay = formatTaka(remainingAmount);
const percentDisplay = isBn ? `${toBnDigits(progressPercent)}%` : `${progressPercent}%`;

// All 33 report pages for comprehensive document viewer
const allReportPages = Array.from({ length: 33 }, (_, i) => i + 1);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>
      {isBn ? 'Save Araf | বাঁচতে চায় ক্যানসার আক্রান্ত ১৭ বছরের কিশোর আরাফ' : 'Save Araf | Help 17-Year-Old Araf Fight Cancer'}
    </title>
    <meta
      name="description"
      content={isBn
        ? 'মাত্র ১৭ বছর বয়সে ব্লাড ক্যানসারে (AML) আক্রান্ত কিশোর মো. আরাফ। ঢাকা মেডিকেলের কেবিন ১১৪/বি-তে চলছে টানা কেমোথেরাপি ও প্লাটিলেট। ছেলেকে বাঁচাতে সমাজের সহৃদয় মানুষদের কাছে পরিবারের আকুল আবেদন।'
        : '17-year-old Md. Araf is fighting Acute Myeloid Leukemia (AML) at DMCH Cabin 114/B. Urgent appeal for B+ platelets, blood, and medical funds.'}
    />
    <meta
      name="keywords"
      content="Save Araf, বাঁচাও আরাফ, ব্লাড ক্যানসার, AML, Acute Myeloid Leukemia, ঢাকা মেডিকেল কলেজ হাসপাতাল, হেমাটোলজি বিভাগ, ব্লাড ডোনার, প্লাটিলেট SDP, B+ Blood Donor, শেখ মাহমুদ ইসলাম মিজু, ডোনেশন, মানবিক আবেদন, সময়ের আলো"
    />
    <meta name="author" content="Sheikh Mahmud Islam Mizu" />
    <meta name="robots" content="index, follow" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={isBn ? 'Save Araf | বাঁচতে চায় ক্যানসার আক্রান্ত ১৭ বছরের কিশোর আরাফ' : 'Save Araf | Help Araf Fight Acute Myeloid Leukemia'} />
    <meta
      property="og:description"
      content={isBn
        ? 'আরাফের শরীরে প্রাণঘাতী ব্লাড ক্যানসার (AML)। পিতা মে মাস থেকে কর্মহীন। ঢাকা মেডিকেলে চলছে কেমো ও প্লাটিলেট। আপনার সামান্য অনুদান বা দোয়াই পারে ছেলেটাকে বাঁচাতে।'
        : '17-year-old Araf is battling blood cancer (AML) at DMCH. His father is unemployed. Urgent appeal for treatment support.'}
    />
    <meta property="og:image" content={heroHospitalImg} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={isBn ? 'Save Araf | ১৭ বছরের আরাফের জীবন বাঁচাতে এগিয়ে আসুন' : 'Save Araf | Emergency Medical Appeal for 17-Year-Old Araf'} />
    <meta property="twitter:description" content={isBn ? 'ঢাকা মেডিকেল কলেজ হাসপাতালের ১১৪/বি কেবিনে চলছে কেমো ও প্লাটিলেট। চিকিৎসায় প্রয়োজন প্রায় ৪০ লাখ টাকা।' : 'Undergoing chemotherapy at DMCH Cabin 114/B. Estimated treatment cost 40 Lakh BDT.'} />
    <meta property="twitter:image" content={heroHospitalImg} />

    <!-- Google Fonts: Hind Siliguri & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Lucide Icons -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>

    <!-- Performance Preloads -->
