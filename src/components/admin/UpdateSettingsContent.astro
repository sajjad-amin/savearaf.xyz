            </div>
          </div>

          <!-- Dynamic Live Calculation Preview Cards -->
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3 p-4 rounded-xl bg-gray-50/80 border border-gray-200">
            <div>
              <span class="text-[11px] font-semibold text-gray-500 uppercase block mb-0.5">
                {isBn ? 'সংগৃহীত' : 'Raised'}
              </span>
              <p id="preview-raised" class="text-base sm:text-lg font-black text-emerald-700 font-mono">
                ৳ {initialRaised.toLocaleString('en-US')}
              </p>
            </div>
            <div>
              <span class="text-[11px] font-semibold text-gray-500 uppercase block mb-0.5">
                {isBn ? 'অবশিষ্ট প্রয়োজন' : 'Remaining Required'}
              </span>
              <p id="preview-remaining" class="text-base sm:text-lg font-black text-rose-600 font-mono">
