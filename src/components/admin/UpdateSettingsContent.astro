---
import Navbar from '@/components/common/Navbar.astro';
import Footer from '@/components/common/Footer.astro';
import { db } from '@/db';
import { campaignSettings } from '@/db/schema';
import { eq } from 'drizzle-orm';

interface Props {
  lang: 'bn' | 'en';
}

const { lang } = Astro.props;
const isBn = lang === 'bn';

const session = Astro.locals.session;
const currentUser = Astro.locals.user;

// Security check: Only Admins can access update landing page
if (!session || !currentUser || currentUser.role !== 'admin') {
  return Astro.redirect(isBn ? '/' : '/en');
}

// Fetch current settings for instant SSR hydration
let initialSettings = null;
try {
  const [row] = await db
    .select()
    .from(campaignSettings)
    .where(eq(campaignSettings.id, 1))
    .limit(1);
  initialSettings = row || null;
} catch (err) {
  console.error('Error fetching campaign settings in SSR:', err);
}

const settings = initialSettings || {
  id: 1,
  hospitalCabinBn: 'ডিএমসিএইচ ১১৪/বি',
  hospitalCabinEn: 'DMCH Cabin 114/B',
  treatmentPhaseBn: 'আজ ৩য় দিনের কেমো চলছে',
  treatmentPhaseEn: 'Day 3 of Intensive Chemotherapy',
  doctorNameBn: 'ডা. হুমায়রা নাজনীন',
  doctorNameEn: 'Dr. Humayra Nazneen',
  dailyUpdateTextBn:
    'আজ আরাফের ৩য় দিনের কেমোথেরাপির জটিল চক্র চলছে। সেন্ট্রাল ভেনাস লাইন (সিভি লাইন)-এর মাধ্যমে একটানা উচ্চমাত্রার কেমো এবং ওষুধ চলায় ওর শরীর প্রচণ্ড দুর্বল। রক্তের প্লাটিলেট ও প্রয়োজনীয় সেল বারবার আশঙ্কাজনকভাবে কমে যাচ্ছে। সার্বক্ষণিক B+ হোল ব্লাড ও সিঙ্গেল ডোনার প্লাটিলেট (SDP) ব্যাকআপে রাখা অত্যন্ত জরুরি।',
  dailyUpdateTextEn:
    'Araf is currently on Day 3 of his intensive chemotherapy cycle. Continuous high-dose chemo and medications through his Central Venous (CV) line have made him extremely frail. His blood platelets and essential cells are rapidly falling to critical thresholds. Maintaining an immediate standby of B+ Whole Blood and Single Donor Platelets (SDP) is life-critical.',
  platelets: '36,000',
  wbc: '3,460',
  hb: '7.6',
  blast: '90%',
  creatinine: '0.2',
  uricAcid: '4.8',
  alt: '14.83',
  anc: '1,800',
  fundTarget: 4000000,
  fundRaised: 137841,
  emergencyTextBn:
    'হাসপাতাল কেবিন: ডিএমসিএইচ ১১৪/বি • আজ ৩য় দিনের কেমো চলছে • রক্তের গ্রুপ: B+ (বি পজিটিভ) • জরুরি B+ রক্ত ও প্লাটিলেট (SDP) প্রয়োজন',
  emergencyTextEn:
    'DMCH Cabin 114/B • Day 3 of Intensive Chemotherapy • Blood Group: B+ (Positive) • Urgent need for B+ Blood & SDP Platelets',
  enableScrolling: false,
  scrollSpeed: 20,
  updatedAt: null,
};

const initialTarget = settings.fundTarget ? Number(settings.fundTarget) : 4000000;
const initialRaised = settings.fundRaised ? Number(settings.fundRaised) : 137841;
const initialRemaining = Math.max(0, initialTarget - initialRaised);
const initialPercent = initialTarget > 0 ? ((initialRaised / initialTarget) * 100).toFixed(2) : '0.00';

function toEnDigits(val: string | null | undefined, fallback: string = ''): string {
  if (!val) return fallback;
  const bnToEnMap: Record<string, string> = {
    '০': '0', '১': '1', '২': '2', '৩': '3', '৪': '4',
    '৫': '5', '৬': '6', '৭': '7', '৮': '8', '৯': '9',
  };
  return String(val).replace(/[০-৯]/g, (d) => bnToEnMap[d] || d);
}

const plateletsVal = toEnDigits(settings.platelets, '36,000');
const wbcVal = toEnDigits(settings.wbc, '3,460');
const hbVal = toEnDigits(settings.hb, '7.6');
const blastVal = toEnDigits(settings.blast, '90%');
const creatinineVal = toEnDigits(settings.creatinine, '0.2');
const uricAcidVal = toEnDigits(settings.uricAcid, '4.8');
const altVal = toEnDigits(settings.alt, '14.83');
const ancVal = toEnDigits(settings.anc, '1,800');
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isBn ? 'ওয়েবসাইট ও ক্যাম্পেইন আপডেট' : 'Update Landing & Campaign Settings'} - Save Araf</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased">
    <!-- Navbar -->
    <Navbar lang={lang} />

    <!-- Main Content -->
    <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      <!-- Header Area -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-gray-200">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-black bg-rose-100 text-rose-700 uppercase tracking-wider">
              {isBn ? 'অ্যাডমিন পোর্টাল' : 'Admin Portal'}
            </span>
            <span class="text-xs text-gray-400">/</span>
            <span class="text-xs text-gray-500 font-semibold">{isBn ? 'ওয়েবসাইট আপডেট' : 'Update Landing'}</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-gray-900 mt-1 flex items-center gap-2.5">
            <span>⚙️</span>
            <span>{isBn ? 'ওয়েবসাইট ও ক্যাম্পেইন তথ্য হালনাগাদ (দ্বিভাষিক)' : 'Update Campaign & Landing Settings (Bilingual)'}</span>
          </h1>
          <p class="text-xs sm:text-sm text-gray-600 mt-1">
            {isBn
              ? 'বাংলা ও ইংরেজি উভয় ভাষার জন্য চিকিৎসা পরিস্থিতি, রক্তের কাউন্ট রিপোর্ট এবং ফান্ড ট্র্যাকিং তথ্য সরাসরি আপডেট করুন।'
              : 'Directly update clinical status, blood biomarker reports, and fundraising progress for both Bengali and English visitors.'}
          </p>
        </div>

        <!-- Quick link to Landing Page -->
        <div class="flex items-center gap-2.5">
          <a
            href={isBn ? '/' : '/en'}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-gray-300 bg-white hover:bg-gray-100 text-gray-800 font-bold text-xs sm:text-sm shadow-xs transition"
          >
            <span>👁️</span>
            <span>{isBn ? 'লাইভ পেজ দেখুন' : 'View Live Landing'}</span>
          </a>
        </div>
      </div>

      <!-- Admin Navigation Tabs -->
      <div class="flex items-center gap-2 border-b border-gray-200 mt-6 mb-6 overflow-x-auto whitespace-nowrap">
        <a
          href={isBn ? '/admin/crm' : '/en/admin/crm'}
          class="py-2.5 px-4 text-xs sm:text-sm font-bold border-b-2 border-transparent text-gray-500 hover:text-gray-800 flex items-center gap-1.5"
        >
          <span>🩸</span>
          <span>{isBn ? 'ব্লাড ডোনার সিআরএম' : 'Blood CRM'}</span>
        </a>
        <a
          href={isBn ? '/admin/users' : '/en/admin/users'}
          class="py-2.5 px-4 text-xs sm:text-sm font-bold border-b-2 border-transparent text-gray-500 hover:text-gray-800 flex items-center gap-1.5"
        >
          <span>👥</span>
          <span>{isBn ? 'ইউজার ম্যানেজমেন্ট' : 'User Management'}</span>
        </a>
        <a
          href={isBn ? '/admin/update' : '/en/admin/update'}
          class="py-2.5 px-4 text-xs sm:text-sm font-bold border-b-2 border-rose-600 text-rose-600 flex items-center gap-1.5"
        >
          <span>⚙️</span>
          <span>{isBn ? 'ওয়েবসাইট আপডেট' : 'Update Landing'}</span>
        </a>
      </div>

      <!-- Feedback Alert Notification Banner -->
      <div id="feedback-alert" class="hidden mb-6 p-4 rounded-2xl border transition-all duration-300">
        <div class="flex items-center gap-3">
          <span id="feedback-icon" class="text-xl"></span>
          <div class="flex-1">
            <h3 id="feedback-title" class="text-sm font-bold"></h3>
            <p id="feedback-message" class="text-xs mt-0.5"></p>
          </div>
          <button
            type="button"
            id="close-feedback-btn"
            class="text-gray-400 hover:text-gray-700 text-sm font-bold p-1"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Settings Form -->
      <form id="campaign-settings-form" class="space-y-8">
        <!-- ======================================================== -->
        <!-- SECTION 1: CLINICAL STATUS & DAILY UPDATES (BILINGUAL)  -->
        <!-- ======================================================== -->
        <section class="bg-white rounded-2xl border border-gray-200 p-6 sm:p-8 shadow-xs space-y-6">
          <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
            <span class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl shrink-0 font-bold">
              🏥
            </span>
            <div>
              <h2 class="text-lg font-black text-gray-900">
                {isBn ? '১. চিকিৎসা ও বর্তমান অবস্থা (দ্বিভাষিক)' : '1. Clinical Status & Current Condition (Bilingual)'}
              </h2>
              <p class="text-xs text-gray-500">
                {isBn
                  ? 'হাসপাতাল কেবিন, কেমো পর্যায়, ডাক্তার এবং দৈনিক শারীরিক পরিস্থিতির বাংলা ও ইংরেজি বিবরণ'
                  : 'Hospital cabin, chemo cycle, physician, and daily clinical situation in both Bengali & English'}
              </p>
            </div>
          </div>

          <!-- Pair 1: Hospital Cabin -->
          <div class="p-4 rounded-xl bg-gray-50/70 border border-gray-200/80 space-y-3">
            <h3 class="text-xs font-black text-gray-800 uppercase tracking-wider flex items-center gap-1.5">
              <span>📍</span>
              <span>{isBn ? 'হাসপাতাল ও কেবিন নম্বর (Hospital Cabin)' : 'Hospital & Cabin'}</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="hospitalCabinBn" class="block text-xs font-bold text-gray-700 mb-1">
                  বাংলা (Bengali) <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="hospitalCabinBn"
                  name="hospitalCabinBn"
                  value={settings.hospitalCabinBn || ''}
                  placeholder="যেমন: ডিএমসিএইচ ১১৪/বি"
                  required
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm bg-white"
                />
              </div>
              <div>
                <label for="hospitalCabinEn" class="block text-xs font-bold text-gray-700 mb-1">
                  English <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="hospitalCabinEn"
                  name="hospitalCabinEn"
                  value={settings.hospitalCabinEn || ''}
                  placeholder="e.g., DMCH Cabin 114/B"
                  required
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm bg-white"
                />
              </div>
            </div>
          </div>

          <!-- Pair 2: Treatment Phase / Chemo Day -->
          <div class="p-4 rounded-xl bg-gray-50/70 border border-gray-200/80 space-y-3">
            <h3 class="text-xs font-black text-gray-800 uppercase tracking-wider flex items-center gap-1.5">
              <span>💉</span>
              <span>{isBn ? 'চিকিৎসা পর্যায় / কেমোর দিন (Treatment Stage)' : 'Treatment Stage / Chemo Day'}</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="treatmentPhaseBn" class="block text-xs font-bold text-gray-700 mb-1">
                  বাংলা (Bengali) <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="treatmentPhaseBn"
                  name="treatmentPhaseBn"
                  value={settings.treatmentPhaseBn || ''}
                  placeholder="যেমন: আজ ৩য় দিনের কেমো চলছে"
                  required
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm bg-white"
                />
              </div>
              <div>
                <label for="treatmentPhaseEn" class="block text-xs font-bold text-gray-700 mb-1">
                  English <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="treatmentPhaseEn"
                  name="treatmentPhaseEn"
                  value={settings.treatmentPhaseEn || ''}
                  placeholder="e.g., Day 3 of Intensive Chemotherapy"
                  required
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm bg-white"
                />
              </div>
            </div>
          </div>

          <!-- Pair 3: Attending Physician -->
          <div class="p-4 rounded-xl bg-gray-50/70 border border-gray-200/80 space-y-3">
            <h3 class="text-xs font-black text-gray-800 uppercase tracking-wider flex items-center gap-1.5">
              <span>🩺</span>
              <span>{isBn ? 'তত্ত্বাবধায়ক চিকিৎসক (Attending Physician)' : 'Attending Physician'}</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="doctorNameBn" class="block text-xs font-bold text-gray-700 mb-1">
                  বাংলা (Bengali) <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="doctorNameBn"
                  name="doctorNameBn"
                  value={settings.doctorNameBn || ''}
                  placeholder="যেমন: ডা. হুমায়রা নাজনীন"
                  required
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm bg-white"
                />
              </div>
              <div>
                <label for="doctorNameEn" class="block text-xs font-bold text-gray-700 mb-1">
                  English <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="doctorNameEn"
                  name="doctorNameEn"
                  value={settings.doctorNameEn || ''}
                  placeholder="e.g., Dr. Humayra Nazneen"
                  required
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm bg-white"
                />
              </div>
            </div>
          </div>

          <!-- Pair 4: Daily Clinical Update (Textareas) -->
          <div class="p-4 rounded-xl bg-gray-50/70 border border-gray-200/80 space-y-3">
            <h3 class="text-xs font-black text-gray-800 uppercase tracking-wider flex items-center gap-1.5">
              <span>📝</span>
              <span>{isBn ? 'আজকের পরিস্থিতি ও শারীরিক আপডেট (দৈনিক বার্তা)' : 'Daily Clinical Update Text'}</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="dailyUpdateTextBn" class="block text-xs font-bold text-gray-700 mb-1">
                  বাংলা (Bengali) <span class="text-rose-500">*</span>
                </label>
                <textarea
                  id="dailyUpdateTextBn"
                  name="dailyUpdateTextBn"
                  rows="4"
                  required
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm bg-white leading-relaxed"
                  placeholder="আরাফের শারীরিক অবস্থা এবং রক্তের প্রয়োজনের বিস্তারিত বাংলা বিবরণ..."
                >{settings.dailyUpdateTextBn || ''}</textarea>
              </div>
              <div>
                <label for="dailyUpdateTextEn" class="block text-xs font-bold text-gray-700 mb-1">
                  English <span class="text-rose-500">*</span>
                </label>
                <textarea
                  id="dailyUpdateTextEn"
                  name="dailyUpdateTextEn"
                  rows="4"
                  required
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm bg-white leading-relaxed"
                  placeholder="Detailed clinical situation and blood requirements in English..."
                >{settings.dailyUpdateTextEn || ''}</textarea>
              </div>
            </div>
          </div>
        </section>

        <!-- ======================================================== -->
        <!-- SECTION 2: BLOOD COUNTS & BIOMARKERS (UNIFIED NUMERICAL)-->
        <!-- ======================================================== -->
        <section class="bg-white rounded-2xl border border-gray-200 p-6 sm:p-8 shadow-xs space-y-6">
          <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
            <span class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl shrink-0 font-bold">
              🔬
            </span>
            <div>
              <h2 class="text-lg font-black text-gray-900">
                {isBn ? '২. রক্তের রিপোর্ট (সিভিসি বায়োমার্কার)' : '2. Blood Counts (CVC Biomarkers)'}
              </h2>
              <p class="text-xs text-gray-500">
                {isBn
                  ? 'ইংরেজি ডিজিটে ইনপুট দিন (যেমন: 7.6 বা 8.2)। ল্যান্ডিং পেজে স্বয়ংক্রিয়ভাবে বাংলা/ইংরেজি উভয় ফরম্যাটে রূপান্তরিত হবে।'
                  : 'Enter in standard English digits (e.g., 7.6 or 8.2). Automatically localized on the public landing page.'}
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <!-- Platelets -->
            <div class="bg-gray-50/60 p-3.5 rounded-xl border border-gray-200">
              <label for="platelets" class="block text-xs font-bold text-gray-700 mb-1">
                {isBn ? 'প্লাটিলেট (Platelets)' : 'Platelets (/μL)'}
              </label>
              <input
                type="text"
                id="platelets"
                name="platelets"
                value={plateletsVal}
                placeholder="36,000"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm font-semibold bg-white"
              />
              <span class="text-[10px] text-gray-400 mt-1 block">{isBn ? 'স্বাভাবিক: 150k - 450k' : 'Normal: 150k - 450k'}</span>
            </div>

            <!-- WBC -->
            <div class="bg-gray-50/60 p-3.5 rounded-xl border border-gray-200">
              <label for="wbc" class="block text-xs font-bold text-gray-700 mb-1">
                {isBn ? 'ডব্লিউবিসি (WBC)' : 'WBC (/μL)'}
              </label>
              <input
                type="text"
                id="wbc"
                name="wbc"
                value={wbcVal}
                placeholder="3,460"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm font-semibold bg-white"
              />
              <span class="text-[10px] text-gray-400 mt-1 block">{isBn ? 'স্বাভাবিক: 4k - 11k' : 'Normal: 4k - 11k'}</span>
            </div>

            <!-- Hb -->
            <div class="bg-gray-50/60 p-3.5 rounded-xl border border-gray-200">
              <label for="hb" class="block text-xs font-bold text-gray-700 mb-1">
                {isBn ? 'হিমোগ্লোবিন (Hb)' : 'Hemoglobin (g/dL)'}
              </label>
              <input
                type="text"
                id="hb"
                name="hb"
                value={hbVal}
                placeholder="7.6"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm font-semibold bg-white"
              />
              <span class="text-[10px] text-gray-400 mt-1 block">{isBn ? 'স্বাভাবিক: 13.0 - 17.0' : 'Normal: 13.0 - 17.0'}</span>
            </div>

            <!-- Blast -->
            <div class="bg-gray-50/60 p-3.5 rounded-xl border border-gray-200">
              <label for="blast" class="block text-xs font-bold text-gray-700 mb-1">
                {isBn ? 'ব্লাস্ট সেল (Blast %)' : 'Blast Cell (%)'}
              </label>
              <input
                type="text"
                id="blast"
                name="blast"
                value={blastVal}
                placeholder="90%"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm font-semibold bg-white"
              />
              <span class="text-[10px] text-gray-400 mt-1 block">{isBn ? 'AML ক্যানসার সেল' : 'Leukemic blasts'}</span>
            </div>

            <!-- Creatinine -->
            <div class="bg-gray-50/60 p-3.5 rounded-xl border border-gray-200">
              <label for="creatinine" class="block text-xs font-bold text-gray-700 mb-1">
                {isBn ? 'ক্রিয়েটিনিন (Creatinine)' : 'Creatinine (mg/dL)'}
              </label>
              <input
                type="text"
                id="creatinine"
                name="creatinine"
                value={creatinineVal}
                placeholder="0.2"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm font-semibold bg-white"
              />
              <span class="text-[10px] text-gray-400 mt-1 block">{isBn ? 'স্বাভাবিক: 0.7 - 1.3' : 'Normal: 0.7 - 1.3'}</span>
            </div>

            <!-- Uric Acid -->
            <div class="bg-gray-50/60 p-3.5 rounded-xl border border-gray-200">
              <label for="uricAcid" class="block text-xs font-bold text-gray-700 mb-1">
                {isBn ? 'ইউরিক অ্যাসিড (Uric Acid)' : 'Uric Acid (mg/dL)'}
              </label>
              <input
                type="text"
                id="uricAcid"
                name="uricAcid"
                value={uricAcidVal}
                placeholder="4.8"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm font-semibold bg-white"
              />
              <span class="text-[10px] text-gray-400 mt-1 block">{isBn ? 'স্বাভাবিক: 3.5 - 7.2' : 'Normal: 3.5 - 7.2'}</span>
            </div>

            <!-- ALT / SGPT -->
            <div class="bg-gray-50/60 p-3.5 rounded-xl border border-gray-200">
              <label for="alt" class="block text-xs font-bold text-gray-700 mb-1">
                {isBn ? 'এএলটি / এসজিপিটি (ALT)' : 'SGPT/ALT (U/L)'}
              </label>
              <input
                type="text"
                id="alt"
                name="alt"
                value={altVal}
                placeholder="14.83"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm font-semibold bg-white"
