              <span class="text-[10px] text-gray-400 mt-1 block">{isBn ? 'লিভার এনজাইম' : 'Liver function'}</span>
            </div>

            <!-- ANC -->
            <div class="bg-gray-50/60 p-3.5 rounded-xl border border-gray-200">
              <label for="anc" class="block text-xs font-bold text-gray-700 mb-1">
                {isBn ? 'এএনসি (ANC)' : 'ANC (/μL)'}
              </label>
              <input
                type="text"
                id="anc"
                name="anc"
                value={ancVal}
                placeholder="1,800"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm font-semibold bg-white"
              />
              <span class="text-[10px] text-gray-400 mt-1 block">{isBn ? 'নিউট্রোফিল কাউন্ট' : 'Neutrophil count'}</span>
            </div>
          </div>
        </section>

        <!-- ======================================================== -->
        <!-- SECTION 3: FUND TRACKING & PROGRESS                     -->
        <!-- ======================================================== -->
        <section class="bg-white rounded-2xl border border-gray-200 p-6 sm:p-8 shadow-xs space-y-6">
          <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
            <span class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0 font-bold">
              💰
            </span>
            <div>
              <h2 class="text-lg font-black text-gray-900">
                {isBn ? '৩. ফান্ড ট্র্যাকিং ও অনুদান হিসাব' : '3. Fund Tracking & Goal Progress'}
              </h2>
              <p class="text-xs text-gray-500">
                {isBn
                  ? 'চিকিৎসা খরচের মোট টার্গেট এবং এ পর্যন্ত সংগৃহীত অনুদানের পরিমাণ (টাকায়)'
                  : 'Total campaign financial target and audited raised funds in BDT'}
              </p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Fund Target -->
            <div>
              <label for="fundTarget" class="block text-xs font-bold text-gray-700 mb-1.5">
                {isBn ? 'মোট লক্ষ্যমাত্রা (টাকায়)' : 'Target Goal (in BDT)'} <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center font-bold text-gray-400 text-sm">৳</span>
                <input
                  type="number"
                  id="fundTarget"
                  name="fundTarget"
                  value={settings.fundTarget || 4000000}
                  step="1000"
                  min="0"
                  required
                  class="w-full pl-8 pr-3.5 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-sm font-mono font-bold bg-gray-50/50"
                />
              </div>
              <span class="text-[11px] text-gray-400 mt-1 block">
                {isBn ? 'যেমন: ৪০,০০,০০০ (৪০ লাখ টাকা)' : 'Default: 4,000,000 (40 Lakh BDT)'}
