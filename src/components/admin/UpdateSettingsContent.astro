        </section>

        <!-- ======================================================== -->
        <!-- SECTION 4: EMERGENCY TOP BAR (BILINGUAL & MARQUEE)      -->
        <!-- ======================================================== -->
        <section class="bg-white rounded-2xl border border-gray-200 p-6 sm:p-8 shadow-xs space-y-6">
          <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
            <span class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl shrink-0 font-bold">
              🚨
            </span>
            <div>
              <h2 class="text-lg font-black text-gray-900">
                {isBn ? '৪. ইমার্জেন্সি টপ বার (Emergency Top Bar)' : '4. Emergency Top Bar (Bilingual & Marquee)'}
              </h2>
              <p class="text-xs text-gray-500">
                {isBn
                  ? 'ওয়েবসাইটের একদম শীর্ষে প্রদর্শিত লাল জরুরি সতর্কবার্তা এবং টেক্সট স্ক্রলিং (মারকুই) নিয়ন্ত্রণ'
                  : 'Red emergency announcement banner at top of site and marquee scrolling animation controls'}
              </p>
            </div>
          </div>

          <!-- Bilingual Emergency Text -->
          <div class="p-4 rounded-xl bg-gray-50/70 border border-gray-200/80 space-y-3">
            <h3 class="text-xs font-black text-gray-800 uppercase tracking-wider flex items-center gap-1.5">
              <span>📢</span>
              <span>{isBn ? 'জরুরি সতর্কবার্তা টেক্সট (Emergency Announcement Text)' : 'Emergency Announcement Text'}</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="emergencyTextBn" class="block text-xs font-bold text-gray-700 mb-1">
                  বাংলা (Bengali) <span class="text-rose-500">*</span>
                </label>
                <textarea
                  id="emergencyTextBn"
                  name="emergencyTextBn"
                  rows="3"
                  placeholder="যেমন: হাসপাতাল কেবিন: ডিএমসিএইচ ১১৪/বি • আজ ৩য় দিনের কেমো চলছে • রক্তের গ্রুপ: B+ (বি পজিটিভ) • জরুরি B+ রক্ত ও প্লাটিলেট (SDP) প্রয়োজন"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm bg-white"
                >{settings.emergencyTextBn || ''}</textarea>
                <span class="text-[10px] text-gray-400 mt-1 block">
                  {isBn ? 'ওয়েবসাইটে বাংলা নির্বাচিত থাকলে এই টেক্সট প্রদর্শিত হবে।' : 'Shown when viewing in Bengali.'}
                </span>
              </div>
              <div>
                <label for="emergencyTextEn" class="block text-xs font-bold text-gray-700 mb-1">
                  English <span class="text-rose-500">*</span>
                </label>
                <textarea
                  id="emergencyTextEn"
                  name="emergencyTextEn"
                  rows="3"
                  placeholder="e.g., DMCH Cabin 114/B • Day 3 of Intensive Chemotherapy • Blood Group: B+ (Positive) • Urgent need for B+ Blood & SDP Platelets"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm bg-white"
                >{settings.emergencyTextEn || ''}</textarea>
                <span class="text-[10px] text-gray-400 mt-1 block">
                  {isBn ? 'ওয়েবসাইটে ইংরেজি নির্বাচিত থাকলে এই টেক্সট প্রদর্শিত হবে।' : 'Shown when viewing in English.'}
                </span>
              </div>
            </div>
          </div>

          <!-- Scrolling Animation Controls -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Toggle: Enable Scrolling -->
            <div class="p-4 rounded-xl bg-gray-50/70 border border-gray-200/80 flex items-center justify-between gap-4">
              <div>
                <label for="enableScrolling" class="text-xs font-black text-gray-800 uppercase tracking-wider block cursor-pointer">
                  {isBn ? 'টেক্সট স্ক্রল / মারকুই অ্যানিমেশন' : 'Enable Marquee Scrolling'}
                </label>
                <p class="text-[11px] text-gray-500 mt-0.5">
                  {isBn
                    ? 'চালু করলে জরুরি টেক্সট স্ক্রিনের একপাশ থেকে অন্যপাশে ক্রমাগত স্ক্রল করবে।'
                    : 'When enabled, the emergency text scrolls continuously across the top bar.'}
                </p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer shrink-0">
                <input
                  type="checkbox"
                  id="enableScrolling"
                  name="enableScrolling"
                  checked={settings.enableScrolling}
                  class="sr-only peer"
                />
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-rose-400 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-rose-600"></div>
              </label>
            </div>

            <!-- Scroll Speed (Seconds) -->
            <div class="p-4 rounded-xl bg-gray-50/70 border border-gray-200/80 space-y-2">
              <div class="flex items-center justify-between">
                <label for="scrollSpeed" class="text-xs font-black text-gray-800 uppercase tracking-wider">
                  {isBn ? 'স্ক্রল স্পিড / সময়কাল (সেকেন্ড)' : 'Scroll Duration (Seconds)'}
                </label>
                <span id="speed-indicator" class="text-xs font-mono font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded">
                  {settings.scrollSpeed || 20}s
                </span>
              </div>
              <input
                type="number"
                id="scrollSpeed"
                name="scrollSpeed"
                value={settings.scrollSpeed || 20}
                min="5"
                max="60"
                step="1"
                class="w-full px-3.5 py-2 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm font-mono font-bold bg-white"
              />
              <span class="text-[10px] text-gray-400 block">
                {isBn
                  ? 'মান যত কম হবে গতি তত দ্রুত হবে (ডিফল্ট: ২০ সেকেন্ড, গ্রহণযোগ্য: ৫ থেকে ৬০ সেকেন্ড)।'
                  : 'Lower seconds = faster scroll (Default: 20s, Recommended: 10s–30s).'}
              </span>
            </div>
          </div>
        </section>

        <!-- Save Actions Floating / Fixed Bar -->
        <div class="flex items-center justify-between gap-4 pt-4 border-t border-gray-200">
          <p class="text-xs text-gray-500">
            {isBn
              ? 'সেটিংস সংরক্ষণ করার সাথে সাথে ল্যান্ডিং পেজে তথ্য সরাসরি পরিবর্তিত হবে।'
              : 'Changes will be reflected immediately on the live landing page after saving.'}
          </p>

          <div class="flex items-center gap-3">
            <button
              type="button"
              id="reset-form-btn"
              class="px-5 py-2.5 rounded-xl border border-gray-300 bg-white hover:bg-gray-100 text-gray-700 text-xs sm:text-sm font-bold transition cursor-pointer"
            >
              {isBn ? 'পুনরুদ্ধার করুন' : 'Reset Form'}
            </button>

            <button
              type="submit"
              id="submit-settings-btn"
              class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-white text-xs sm:text-sm font-bold shadow-sm shadow-rose-600/30 transition cursor-pointer"
            >
              <span id="btn-icon">💾</span>
              <span id="btn-text">{isBn ? 'পরিবর্তন সংরক্ষণ করুন' : 'Save Changes'}</span>
            </button>
          </div>
        </div>
      </form>
    </main>

    <!-- Footer -->
    <Footer lang={lang} />

    <!-- Client-Side Form Logic & AJAX -->
    <script>
      const form = document.getElementById('campaign-settings-form') as HTMLFormElement;
      const submitBtn = document.getElementById('submit-settings-btn') as HTMLButtonElement;
      const resetBtn = document.getElementById('reset-form-btn') as HTMLButtonElement;
      const btnText = document.getElementById('btn-text');
      const btnIcon = document.getElementById('btn-icon');

      const alertBanner = document.getElementById('feedback-alert');
      const alertTitle = document.getElementById('feedback-title');
      const alertMsg = document.getElementById('feedback-message');
      const alertIcon = document.getElementById('feedback-icon');
      const closeAlertBtn = document.getElementById('close-feedback-btn');

      const targetInput = document.getElementById('fundTarget') as HTMLInputElement;
      const raisedInput = document.getElementById('fundRaised') as HTMLInputElement;
      const previewRaised = document.getElementById('preview-raised');
      const previewRemaining = document.getElementById('preview-remaining');
      const previewPercent = document.getElementById('preview-percent');

      const speedInput = document.getElementById('scrollSpeed') as HTMLInputElement;
      const speedIndicator = document.getElementById('speed-indicator');
      speedInput?.addEventListener('input', () => {
        if (speedIndicator) speedIndicator.textContent = `${speedInput.value || 20}s`;
      });

      // Update live preview calculations
      function updateCalculations() {
        const target = Number(targetInput?.value) || 0;
        const raised = Number(raisedInput?.value) || 0;
        const remaining = Math.max(0, target - raised);
        const percent = target > 0 ? ((raised / target) * 100).toFixed(2) : '0.00';

        if (previewRaised) previewRaised.textContent = '৳ ' + raised.toLocaleString('en-US');
        if (previewRemaining) previewRemaining.textContent = '৳ ' + remaining.toLocaleString('en-US');
        if (previewPercent) previewPercent.textContent = percent + '%';
      }

      targetInput?.addEventListener('input', updateCalculations);
      raisedInput?.addEventListener('input', updateCalculations);

      // Feedback display helper
      function showAlert(type: 'success' | 'error', title: string, message: string) {
        if (!alertBanner || !alertTitle || !alertMsg || !alertIcon) return;
        alertBanner.classList.remove('hidden', 'bg-emerald-50', 'border-emerald-200', 'text-emerald-900', 'bg-rose-50', 'border-rose-200', 'text-rose-900');

        if (type === 'success') {
          alertBanner.classList.add('bg-emerald-50', 'border-emerald-200', 'text-emerald-900');
          alertIcon.textContent = '✅';
        } else {
          alertBanner.classList.add('bg-rose-50', 'border-rose-200', 'text-rose-900');
          alertIcon.textContent = '⚠️';
        }

        alertTitle.textContent = title;
        alertMsg.textContent = message;
        alertBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      closeAlertBtn?.addEventListener('click', () => {
        alertBanner?.classList.add('hidden');
      });

      // Reset form to latest server state
      resetBtn?.addEventListener('click', async () => {
        try {
          const res = await fetch('/api/admin/settings');
          const data = await res.json();
          if (data.success && data.settings) {
            populateForm(data.settings);
            updateCalculations();
            showAlert('success', 'রিসেট সম্পন্ন', 'ফর্মটিতে ডাটাবেজের মূল তথ্য লোড করা হয়েছে।');
          }
        } catch {
          window.location.reload();
        }
      });

      function populateForm(s: any) {
        const f = form.elements as any;
        if (f.hospitalCabinBn) f.hospitalCabinBn.value = s.hospitalCabinBn || '';
        if (f.hospitalCabinEn) f.hospitalCabinEn.value = s.hospitalCabinEn || '';
        if (f.treatmentPhaseBn) f.treatmentPhaseBn.value = s.treatmentPhaseBn || '';
        if (f.treatmentPhaseEn) f.treatmentPhaseEn.value = s.treatmentPhaseEn || '';
        if (f.doctorNameBn) f.doctorNameBn.value = s.doctorNameBn || '';
        if (f.doctorNameEn) f.doctorNameEn.value = s.doctorNameEn || '';
        if (f.dailyUpdateTextBn) f.dailyUpdateTextBn.value = s.dailyUpdateTextBn || '';
        if (f.dailyUpdateTextEn) f.dailyUpdateTextEn.value = s.dailyUpdateTextEn || '';
        function toEn(val: any, fallback: string = ''): string {
          if (!val) return fallback;
          const map: Record<string, string> = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
          return String(val).replace(/[০-৯]/g, d => map[d] || d);
        }
        if (f.platelets) f.platelets.value = toEn(s.platelets, '36,000');
        if (f.wbc) f.wbc.value = toEn(s.wbc, '3,460');
        if (f.hb) f.hb.value = toEn(s.hb, '7.6');
        if (f.blast) f.blast.value = toEn(s.blast, '90%');
        if (f.creatinine) f.creatinine.value = toEn(s.creatinine, '0.2');
        if (f.uricAcid) f.uricAcid.value = toEn(s.uricAcid, '4.8');
        if (f.alt) f.alt.value = toEn(s.alt, '14.83');
        if (f.anc) f.anc.value = toEn(s.anc, '1,800');
        if (f.fundTarget) f.fundTarget.value = s.fundTarget || 4000000;
        if (f.fundRaised) f.fundRaised.value = s.fundRaised || 0;
        if (f.emergencyTextBn) f.emergencyTextBn.value = s.emergencyTextBn || '';
        if (f.emergencyTextEn) f.emergencyTextEn.value = s.emergencyTextEn || '';
        if (f.enableScrolling) f.enableScrolling.checked = !!s.enableScrolling;
        if (f.scrollSpeed) {
          f.scrollSpeed.value = s.scrollSpeed || 20;
          if (speedIndicator) speedIndicator.textContent = `${s.scrollSpeed || 20}s`;
        }
      }

      // Handle AJAX Form Submission
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Loading state
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.classList.add('opacity-75', 'cursor-wait');
        if (btnText) btnText.textContent = 'সংরক্ষণ করা হচ্ছে...';
        if (btnIcon) btnIcon.textContent = '⏳';

        const formData = new FormData(form);
        const payload: Record<string, any> = {};
        formData.forEach((value, key) => {
          payload[key] = value;
        });
        payload.enableScrolling = !!(form.elements as any).enableScrolling?.checked;
        payload.scrollSpeed = Number((form.elements as any).scrollSpeed?.value) || 20;

        try {
          const res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const data = await res.json();

          if (!res.ok || !data.success) {
            throw new Error(data.error || 'Failed to save settings');
          }

          showAlert(
            'success',
            'সফলভাবে আপডেট করা হয়েছে!',
            'ল্যান্ডিং পেজের সকল দ্বিভাষিক মেট্রিক্স ও শারীরিক আপডেট সফলভাবে সংরক্ষিত হয়েছে।'
          );

          if (data.settings) {
            populateForm(data.settings);
            updateCalculations();
          }
        } catch (err: any) {
          console.error('Error saving settings:', err);
          showAlert(
            'error',
            'সংরক্ষণ ব্যর্থ হয়েছে!',
            err?.message || 'একটি ত্রুটি ঘটেছে। অনুগ্রহ করে পুনরায় চেষ্টা করুন।'
          );
        } finally {
          submitBtn.removeAttribute('disabled');
          submitBtn.classList.remove('opacity-75', 'cursor-wait');
          if (btnText) btnText.textContent = 'পরিবর্তন সংরক্ষণ করুন';
          if (btnIcon) btnIcon.textContent = '💾';
        }
      });
    </script>
  </body>
</html>
