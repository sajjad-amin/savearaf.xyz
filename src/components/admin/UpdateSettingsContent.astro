              </label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center font-bold text-gray-400 text-sm">৳</span>
                <input
                  type="number"
                  id="fundRaised"
                  name="fundRaised"
                  value={settings.fundRaised !== null && settings.fundRaised !== undefined ? settings.fundRaised : 137841}
