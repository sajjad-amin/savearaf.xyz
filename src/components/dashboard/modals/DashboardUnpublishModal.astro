---
interface Props {
  lang: 'bn' | 'en';
}

const { lang } = Astro.props;
const isBn = lang === 'bn';
---

<div
  id="unpublish-self-modal"
  class="fixed inset-0 bg-gray-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-unpublish-headline"
>
  <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-rose-200">
    <div class="flex items-center gap-3 text-rose-600 mb-4">
      <div class="w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center text-xl font-bold">⚠️</div>
      <h3 id="modal-unpublish-headline" class="text-lg font-bold text-gray-900">
        {isBn ? 'ডোনার প্রোফাইল প্রত্যাহার' : 'Unpublish Donor Profile'}
      </h3>
    </div>
    <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mb-6">
      {isBn
        ? 'আপনি কি রক্তদাতা তালিকা থেকে আপনার ডোনার প্রোফাইল মুছে ফেলতে চান? আপনার মূল অ্যাকাউন্ট ও গুগল লগইন সম্পূর্ণ সক্রিয় ও নিরাপদ থাকবে, তবে রক্তদাতা তালিকা থেকে আপনার রেকর্ডটি প্রত্যাহার করা হবে।'
        : 'Are you sure you want to unpublish your donor profile? Your main user account will remain active, but your profile will be removed from the active donor database.'}
    </p>
    <div class="flex items-center gap-3">
      <button
        type="button"
        id="close-unpublish-self-modal-btn"
        class="flex-1 py-2.5 px-4 rounded-xl border border-gray-300 bg-white hover:bg-gray-100 text-gray-700 font-semibold text-sm transition cursor-pointer"
      >
        {isBn ? 'বাতিল' : 'Cancel'}
      </button>
      <form method="POST" action="/api/donor/delete" class="flex-1 m-0">
        <input type="hidden" name="type" value="self" />
        <button
          type="submit"
          class="w-full py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm shadow-xs transition cursor-pointer"
        >
          {isBn ? 'প্রত্যাহার নিশ্চিত করুন' : 'Confirm Unpublish'}
        </button>
      </form>
    </div>
  </div>
</div>
