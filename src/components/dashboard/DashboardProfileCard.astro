---
import DonorForm from '@/components/donor/DonorForm.astro';
import type { SelfDonor, SelfCooldown, DonationItem } from './types';

interface Props {
  lang: 'bn' | 'en';
  initialTab: string;
  user: any;
  selfDonor: SelfDonor;
  selfCooldown: SelfCooldown | null;
  selfDonations: DonationItem[];
  formatDate: (date: Date | string | null | undefined) => string;
}

const { lang, initialTab, user, selfDonor, selfCooldown, selfDonations, formatDate } = Astro.props;
const isBn = lang === 'bn';
---

<section
  id="panel-profile"
  role="tabpanel"
  class={`tab-panel ${initialTab === 'profile' ? '' : 'hidden'}`}
>
  {selfDonor ? (
    <div class="space-y-6">
      <!-- Active Profile Overview Card -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-xs p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6 pb-6 border-b border-gray-100">
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-2xl bg-rose-600 text-white flex flex-col items-center justify-center font-extrabold shadow-sm">
              <span class="text-xs font-semibold leading-none text-rose-200 uppercase">Group</span>
              <span class="text-2xl leading-none mt-0.5">{selfDonor.bloodGroup}</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-gray-900">{selfDonor.name}</h2>
              <p class="text-sm text-gray-600">{selfDonor.phone}</p>
              {selfDonor.location && (
                <p class="text-xs text-gray-600 mt-0.5">📍 {selfDonor.location}</p>
              )}
            </div>
          </div>

          <!-- Status Badge -->
          <div class="flex flex-col sm:items-end">
            <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold ${
              selfCooldown?.status === 'available'
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                : 'bg-amber-50 text-amber-800 border border-amber-200'
            }`}>
              <span>{selfCooldown?.status === 'available' ? '🟢' : '🟡'}</span>
              <span>
                {selfCooldown?.status === 'available'
                  ? isBn
                    ? 'রক্তদানে প্রস্তুত (Available)'
                    : 'Available to Donate'
                  : isBn
                    ? 'কুলডাউনে আছেন (Cooling Down)'
                    : 'Cooling Down'}
              </span>
            </span>

            {selfCooldown?.status === 'cooling_down' && (
              <span class="text-xs text-amber-700 font-semibold mt-1.5">
                {isBn
                  ? `পরবর্তী সম্ভাব্য রক্তদান: ${formatDate(selfCooldown.nextEligibleDate)} (${selfCooldown.daysRemaining} দিন বাকি)`
                  : `Eligible on: ${formatDate(selfCooldown.nextEligibleDate)} (${selfCooldown.daysRemaining} days left)`}
              </span>
            )}
          </div>
        </div>

        <!-- Cooldown Warning Banner if Cooling Down -->
        {selfCooldown?.status === 'cooling_down' && (
          <div class="my-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-xs sm:text-sm flex items-start gap-3">
            <span class="text-lg">⏳</span>
            <div class="space-y-1">
              <p class="font-bold">
                {isBn ? 'নিরাপদ স্বাস্থ্য বিরতি চলমান রয়েছে' : 'Safe Recovery Period in Effect'}
              </p>
              <p class="text-amber-800 leading-relaxed">
                {isBn ? (
                  <span>
                    আপনার পূর্ববর্তী রক্তদানের ধরন অনুযায়ী (<strong>{selfDonor.donationPreference === 'platelets' ? 'প্লাটিলেট (১৫ দিন)' : 'সম্পূর্ণ রক্ত (৯০ দিন)'}</strong>) নিরাপদ বিরতি সময় পার হওয়ার পর আপনি আগামী <strong>{formatDate(selfCooldown.nextEligibleDate)}</strong> তারিখে পুনরায় রক্তদান করতে পারবেন।
                  </span>
                ) : (
                  <span>
                    Based on your preference for <strong>{selfDonor.donationPreference === 'platelets' ? 'Platelets (15-day cooldown)' : 'Whole Blood (90-day cooldown)'}</strong>, you will be eligible to donate again on <strong>{formatDate(selfCooldown.nextEligibleDate)}</strong>.
                  </span>
                )}
              </p>
            </div>
          </div>
        )}

        <!-- Profile Details List -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6">
          <div>
            <span class="block text-xs text-gray-500 font-medium">
              {isBn ? 'রক্তদানের অগ্রাধিকার' : 'Donation Preference'}
            </span>
            <span class="block text-sm font-semibold text-gray-900 mt-1 capitalize">
              {selfDonor.donationPreference === 'platelets'
                ? isBn
                  ? 'প্লাটিলেট (SDP)'
                  : 'Platelets (SDP)'
                : isBn
                  ? 'সম্পূর্ণ রক্ত (Whole Blood)'
                  : 'Whole Blood'}
            </span>
          </div>

          <div>
            <span class="block text-xs text-gray-500 font-medium">
              {isBn ? 'সর্বশেষ রক্তদানের তারিখ' : 'Last Donation Date'}
            </span>
            <span class="block text-sm font-semibold text-gray-900 mt-1">
              {formatDate(selfDonor.lastDonationDate)}
            </span>
          </div>

          <div>
            <span class="block text-xs text-gray-500 font-medium">
              {isBn ? 'পরবর্তী রক্তদানের যোগ্যতা' : 'Next Eligible Date'}
            </span>
            <span class="block text-sm font-semibold text-gray-900 mt-1">
              {selfCooldown?.status === 'cooling_down'
                ? formatDate(selfCooldown.nextEligibleDate)
                : isBn
                  ? 'এখনই প্রস্তুত'
                  : 'Eligible Now'}
            </span>
          </div>
        </div>

        <!-- Action Buttons: Unpublish and Edit Profile -->
        <div class="mt-8 pt-6 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
          <button
            type="button"
            id="open-unpublish-self-modal-btn"
            class="py-2 px-4 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition cursor-pointer"
          >
            {isBn ? '⚠️ ডোনার তালিকা থেকে নিজেকে প্রত্যাহার করুন' : '⚠️ Unpublish My Donor Profile'}
          </button>

          <button
            type="button"
            id="toggle-edit-profile-btn"
            class="py-2 px-4 rounded-xl border border-gray-300 hover:bg-gray-100 text-gray-700 text-xs font-bold transition cursor-pointer"
          >
            {isBn ? '✏️ ডোনার তথ্য পরিবর্তন করুন' : '✏️ Edit Donor Info'}
          </button>
        </div>
      </div>

      <!-- Read-Only Donation History Card for Self Donor -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-xs p-6 sm:p-8">
        <div class="flex items-center justify-between pb-4 border-b border-gray-100">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">📜</span>
            <div>
              <h3 class="text-base font-bold text-gray-900">
                {isBn ? 'রক্তদানের ইতিহাস ও লগ' : 'Donation History & Logs'}
              </h3>
              <p class="text-xs text-gray-500">
                {isBn ? 'আপনার পূর্ববর্তী রক্তদানের সংরক্ষিত বিবরণ (শুধুমাত্র পাঠযোগ্য)' : 'Verified history of your past donations (read-only)'}
              </p>
            </div>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700">
            {isBn ? `মোট ${selfDonations.length} বার` : `${selfDonations.length} Records`}
          </span>
        </div>

        {selfDonations.length === 0 ? (
          <div class="py-8 text-center text-gray-600">
            <span class="text-3xl block mb-2" aria-hidden="true">🩸</span>
            <p class="text-xs font-medium">
              {isBn ? 'এখনো কোনো রক্তদানের হিস্ট্রি রেকর্ড নেই।' : 'No past donation history recorded yet.'}
            </p>
            <p class="text-[11px] text-gray-600 mt-1">
              {isBn ? 'রক্তদান সম্পন্ন হলে অ্যাডমিন তা যাচাই করে সিস্টেমে লিপিবদ্ধ করবেন।' : 'Once you donate, our admin team will verify and log your donation.'}
            </p>
          </div>
        ) : (
          <div class="divide-y divide-gray-100 mt-2">
            {selfDonations.map((item) => {
              const isPlatelet = (item.donationType || item.type || '').toLowerCase().includes('platelet');
              return (
                <div class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold ${
                        isPlatelet ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800'
                      }`}>
                        <span aria-hidden="true">{isPlatelet ? '🟡' : '🩸'}</span>
                        <span>{isPlatelet ? (isBn ? 'প্লাটিলেট (SDP)' : 'Platelet (SDP)') : (isBn ? 'সম্পূর্ণ রক্ত (Whole Blood)' : 'Whole Blood')}</span>
                      </span>
                      <span class="text-xs font-mono font-medium text-gray-700">
                        📅 {formatDate(item.donationDate)}
                      </span>
                    </div>
                    {item.hospital && (
                      <p class="text-xs text-gray-600">
                        🏥 <span class="font-medium">{isBn ? 'হাসপাতাল/কেন্দ্র:' : 'Hospital:'}</span> {item.hospital}
                      </p>
                    )}
                    {item.notes && (
                      <p class="text-xs text-gray-600 italic">
                        📝 {item.notes}
                      </p>
                    )}
                  </div>

                  {item.nextEligibleDate && (
                    <div class="text-left sm:text-right shrink-0">
                      <span class="text-[11px] text-gray-600 block">{isBn ? 'পরবর্তী রক্তদান যোগ্যতা:' : 'Next Eligible Date:'}</span>
                      <span class="text-xs font-bold text-emerald-700">{formatDate(item.nextEligibleDate)}</span>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  ) : (
    <!-- Not Yet Registered as Donor CTA Card -->
    <div class="bg-white rounded-3xl border border-gray-200 shadow-xs p-6 sm:p-8">
      <div class="max-w-2xl">
        <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-2xl font-bold mb-4">
          🩸
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900">
          {isBn ? 'রক্তদাতা হিসেবে নিবন্ধন করুন' : 'Register Yourself as a Donor'}
        </h2>
        <p class="text-sm text-gray-600 mt-2 leading-relaxed">
          {isBn
            ? 'আরাফের চিকিৎসায় নির্দিষ্ট সময় পরপর জরুরি রক্তের প্লাটিলেট ও সম্পূর্ণ রক্ত প্রয়োজন হচ্ছে। আপনি রক্ত বা প্লাটিলেট দান করতে সক্ষম হলে নিচে আপনার রক্তের গ্রুপ ও তথ্য দিয়ে নিজেকে ডোনার হিসেবে তালিকাভুক্ত করুন।'
            : "Araf urgently requires regular blood and platelet (SDP) transfusions. If you are eligible to donate, please register your donor profile below so our coordination team can reach you when needed."}
        </p>
      </div>

      <div class="mt-8 pt-6 border-t border-gray-100">
        <DonorForm
          lang={lang}
          registrationType="self"
          defaultName={user.name || ''}
          defaultPhone={user.phone || ''}
          formId="self-register-form"
          isUpdate={false}
        />
      </div>
    </div>
  )}
</section>

