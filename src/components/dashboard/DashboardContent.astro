---
interface Props {
  lang: 'bn' | 'en';
}

const { lang } = Astro.props;
const isBn = lang === 'bn';

import { db } from '@/db';
import { donors, donations } from '@/db/schema';
import { eq, desc, inArray } from 'drizzle-orm';
import { calculateCooldown, calculateTwoStepCooldown } from '@/lib/cooldown';
import DonorForm from '@/components/donor/DonorForm.astro';
import Navbar from '@/components/common/Navbar.astro';
import Footer from '@/components/common/Footer.astro';

const session = Astro.locals.session;
const user = Astro.locals.user;

const homeUrl = isBn ? '/' : '/en';
const onboardingUrl = isBn ? '/onboarding' : '/en/onboarding';

// Security check: Only logged-in users who completed onboarding can access dashboard
if (!session || !user) {
  return Astro.redirect(homeUrl);
}

if (!user.is_onboarded) {
  return Astro.redirect(onboardingUrl);
}

// 1. Fetch user's own donor profile (if registered)
let selfDonor = null;
try {
  const [dbSelfDonor] = await db
    .select()
    .from(donors)
    .where(eq(donors.userId, user.id))
    .limit(1);
  selfDonor = dbSelfDonor || null;
} catch (error) {
  console.error('Error fetching self donor profile:', error);
}

// 2. Fetch referred donors added by current user
let rawReferredDonors: (typeof donors.$inferSelect)[] = [];
try {
  rawReferredDonors = await db
    .select()
    .from(donors)
    .where(eq(donors.addedByUserId, user.id))
    .orderBy(desc(donors.createdAt));
} catch (error) {
  console.error('Error fetching referred donors:', error);
}

// 3. Fetch donation history for self donor and all referred donors
const userDonorIds: number[] = [];
if (selfDonor) userDonorIds.push(selfDonor.id);
for (const rd of rawReferredDonors) {
  userDonorIds.push(rd.id);
}

let userDonations: (typeof donations.$inferSelect)[] = [];
if (userDonorIds.length > 0) {
  try {
    userDonations = await db
      .select()
      .from(donations)
      .where(inArray(donations.donorId, userDonorIds))
      .orderBy(desc(donations.donationDate));
  } catch (err) {
    console.error('Error fetching user donations:', err);
  }
}

// Map donations by donorId
const donationsByDonorId = new Map<number, typeof userDonations>();
for (const d of userDonations) {
  const list = donationsByDonorId.get(d.donorId) || [];
  list.push(d);
  donationsByDonorId.set(d.donorId, list);
}

const selfDonations = selfDonor ? (donationsByDonorId.get(selfDonor.id) || []) : [];

// 4. Compute dynamic cooldown and eligibility for all donors
const now = new Date();
const twoStepSelf = selfDonor
  ? calculateTwoStepCooldown(selfDonor.lastDonationDate, selfDonor.plateletDonationDate, selfDonations, now)
  : null;

const isPlateletPref = selfDonor?.donationPreference === 'platelets';
const selfCooldown = twoStepSelf
  ? {
      status: twoStepSelf.status === 'available' ? ('available' as const) : ('cooling_down' as const),
      nextEligibleDate: isPlateletPref ? twoStepSelf.nextPlateletEligibleDate : twoStepSelf.nextBloodEligibleDate,
      daysRemaining: isPlateletPref ? twoStepSelf.plateletDaysRemaining : twoStepSelf.bloodDaysRemaining,
      raw: twoStepSelf,
    }
  : null;

const referredDonors = rawReferredDonors.map((d) => {
  const donorDonations = donationsByDonorId.get(d.id) || [];
  const cooldown = calculateTwoStepCooldown(d.lastDonationDate, d.plateletDonationDate, donorDonations, now);
  const isPlatelet = d.donationPreference === 'platelets';
  const nextEligibleDate = isPlatelet ? cooldown.nextPlateletEligibleDate : cooldown.nextBloodEligibleDate;
  const daysRemaining = isPlatelet ? cooldown.plateletDaysRemaining : cooldown.bloodDaysRemaining;

  return {
    ...d,
    computedStatus: cooldown.status === 'available' ? 'available' : 'cooling_down',
    nextEligibleDate,
    daysRemaining,
    history: donorDonations,
    historyCount: donorDonations.length,
    cooldown,
  };
});

// Calculate summary metrics
const totalReferred = referredDonors.length;
const availableReferred = referredDonors.filter((d) => d.computedStatus === 'available').length;
const coolingDownReferred = totalReferred - availableReferred;

const successParam = Astro.url.searchParams.get('success');
const errorParam = Astro.url.searchParams.get('error');
const initialTab = Astro.url.searchParams.get('tab') || (selfDonor ? 'profile' : 'referrals');

// Format date helper
function formatDate(date: Date | string | null | undefined): string {
  if (!date) return isBn ? 'তথ্য নেই' : 'N/A';
  const d = typeof date === 'string' ? new Date(date) : date;
  if (isNaN(d.getTime())) return isBn ? 'তথ্য নেই' : 'N/A';
  return d.toLocaleDateString(isBn ? 'bn-BD' : 'en-US', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}

const bloodGroups = ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'] as const;
const today = new Date().toISOString().split('T')[0];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isBn ? 'ডোনার ড্যাশবোর্ড - Save Araf' : 'Donor Dashboard - Save Araf'}</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased">
    <!-- Revamped Global Navbar -->
    <Navbar lang={lang} />

    <!-- Main Content Container -->
    <main class="max-w-6xl mx-auto px-4 py-8 flex-1 w-full">
      <!-- Error Notification Banners -->
      {errorParam === 'phone_exists_active' && (
        <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">⚠️</span>
            <span class="font-medium">
              {isBn
                ? 'এই ফোন নম্বরটি ইতিমধ্যে একজন সক্রিয় ব্যবহারকারীর প্রোফাইলে যুক্ত আছে। যদি এটি ভুলবশত হয়ে থাকে, তবে অ্যাডমিনের সাথে যোগাযোগ করুন।'
                : 'This phone number is already linked to an active user. If this is a mistake, please contact the admin.'}
            </span>
          </div>
          <button
            type="button"
            onclick="this.parentElement.remove()"
            aria-label={isBn ? 'বিজ্ঞপ্তি বন্ধ করুন' : 'Dismiss notification'}
            class="text-rose-700 hover:text-rose-900 text-sm font-bold px-2 py-1 cursor-pointer"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      )}

      {errorParam === 'phone_exists' && (
        <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">⚠️</span>
            <span class="font-medium">
              {isBn
                ? 'এই ফোন নম্বরটি অন্য একজন রক্তদাতার প্রোফাইলে ব্যবহৃত হচ্ছে।'
                : 'This phone number is already registered to another donor.'}
            </span>
          </div>
          <button
            type="button"
            onclick="this.parentElement.remove()"
            aria-label={isBn ? 'বিজ্ঞপ্তি বন্ধ করুন' : 'Dismiss notification'}
            class="text-rose-700 hover:text-rose-900 text-sm font-bold px-2 py-1 cursor-pointer"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      )}

      <!-- Success Notification Banners -->
      {successParam === 'registered' && (
        <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">✅</span>
            <span class="font-medium">
              {isBn
                ? 'রক্তদাতার তথ্য সফলভাবে সংরক্ষণ করা হয়েছে।'
                : 'Donor details have been successfully saved.'}
            </span>
          </div>
          <button
            type="button"
            onclick="this.parentElement.remove()"
            aria-label={isBn ? 'বিজ্ঞপ্তি বন্ধ করুন' : 'Dismiss notification'}
            class="text-emerald-700 hover:text-emerald-900 text-sm font-bold px-2 py-1 cursor-pointer"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      )}

      {successParam === 'updated' && (
        <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">✅</span>
            <span class="font-medium">
              {isBn
                ? 'রক্তদাতার তথ্য সফলভাবে হালনাগাদ করা হয়েছে।'
                : 'Donor details have been successfully updated.'}
            </span>
          </div>
          <button
            type="button"
            onclick="this.parentElement.remove()"
            aria-label={isBn ? 'বিজ্ঞপ্তি বন্ধ করুন' : 'Dismiss notification'}
            class="text-emerald-700 hover:text-emerald-900 text-sm font-bold px-2 py-1 cursor-pointer"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      )}

      {successParam === 'deleted' && (
        <div class="mb-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">🗑️</span>
            <span class="font-medium">
              {isBn
                ? 'রেফার করা রক্তদাতার তথ্য তালিকা থেকে অপসারণ করা হয়েছে।'
                : 'Referred donor has been removed from your list.'}
            </span>
          </div>
          <button
            type="button"
            onclick="this.parentElement.remove()"
            aria-label={isBn ? 'বিজ্ঞপ্তি বন্ধ করুন' : 'Dismiss notification'}
            class="text-amber-700 hover:text-amber-900 text-sm font-bold px-2 py-1 cursor-pointer"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      )}

      {successParam === 'unregistered' && (
        <div class="mb-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">ℹ️</span>
            <span class="font-medium">
              {isBn
                ? 'আপনার ডোনার প্রোফাইল সফলভাবে প্রত্যাহার করা হয়েছে। আপনার মূল অ্যাকাউন্ট সক্রিয় রয়েছে।'
                : 'Your donor profile has been unpublished. Your user account remains active.'}
            </span>
          </div>
          <button
            type="button"
            onclick="this.parentElement.remove()"
            aria-label={isBn ? 'বিজ্ঞপ্তি বন্ধ করুন' : 'Dismiss notification'}
            class="text-amber-700 hover:text-amber-900 text-sm font-bold px-2 py-1 cursor-pointer"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      )}

      <!-- Welcome & Metrics Overview -->
      <section class="bg-white rounded-3xl border border-gray-200 shadow-xs p-6 sm:p-8 mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-gray-100">
          <div>
            <span class="text-xs uppercase font-bold tracking-wider text-rose-600">
              {isBn ? 'রক্তদাতা ও ডোনার পোর্টাল' : 'Donor CRM & Volunteer Portal'}
            </span>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mt-1">
              {isBn ? `স্বাগতম, ${user.name || 'বন্ধু'}` : `Welcome, ${user.name || 'Friend'}`}
            </h1>
            <p class="text-sm text-gray-500 mt-1">
              {isBn
                ? 'আরাফের চিকিৎসার জন্য রক্ত ও প্লাটিলেট সরবরাহ নিশ্চিত করতে আপনার ভূমিকা অত্যন্ত গুরুত্বপূর্ণ।'
                : 'Your contribution is vital in securing urgent blood and platelet donors for Araf.'}
            </p>
          </div>

          <!-- Quick Action: Refer Button -->
          <div class="w-full sm:w-auto">
            <button
              type="button"
              id="open-referral-modal-btn"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-2.5 px-5 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm shadow-xs transition cursor-pointer"
            >
              <span class="text-base">➕</span>
              <span>{isBn ? 'নতুন রক্তদাতা রেফার করুন' : 'Refer New Donor'}</span>
            </button>
          </div>
        </div>

        <!-- Metric Badges Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
          <!-- Metric 1: My Donor Status -->
          <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
            <span class="text-xs text-gray-500 block mb-1">
              {isBn ? 'আমার ডোনার স্ট্যাটাস' : 'My Donor Status'}
            </span>
            {selfDonor ? (
              <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold ${
                selfCooldown?.status === 'available'
                  ? 'bg-emerald-100 text-emerald-800'
                  : 'bg-amber-100 text-amber-800'
              }`}>
                <span>{selfCooldown?.status === 'available' ? '🟢 প্রস্তুত' : '🟡 বিশ্রামরত'}</span>
                <span>({selfDonor.bloodGroup})</span>
              </span>
            ) : (
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-200 text-gray-700">
                {isBn ? 'নিবন্ধন করা হয়নি' : 'Not Registered'}
              </span>
            )}
          </div>

          <!-- Metric 2: Total Referred -->
          <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200">
            <span class="text-xs text-gray-500 block mb-1">
              {isBn ? 'মোট রেফার করা ডোনার' : 'Total Referred'}
            </span>
            <span class="text-2xl font-extrabold text-gray-900">{totalReferred}</span>
          </div>

          <!-- Metric 3: Ready Donors -->
          <div class="p-4 rounded-2xl bg-emerald-50/60 border border-emerald-100">
            <span class="text-xs text-emerald-700 block mb-1">
              {isBn ? 'রক্তদানে প্রস্তুত' : 'Ready to Donate'}
            </span>
            <span class="text-2xl font-extrabold text-emerald-700">{availableReferred}</span>
          </div>

          <!-- Metric 4: Cooling Down -->
          <div class="p-4 rounded-2xl bg-amber-50/60 border border-amber-100">
            <span class="text-xs text-amber-700 block mb-1">
              {isBn ? 'কুলডাউনে আছেন' : 'Cooling Down'}
            </span>
            <span class="text-2xl font-extrabold text-amber-700">{coolingDownReferred}</span>
          </div>
        </div>
      </section>

      <!-- Dashboard Tabs Switcher -->
      <div class="flex items-center gap-2 border-b border-gray-200 mb-8 overflow-x-auto whitespace-nowrap pb-px" role="tablist">
        <button
          type="button"
          id="tab-btn-profile"
          role="tab"
          aria-selected={initialTab === 'profile'}
          aria-controls="panel-profile"
          class={`tab-btn py-3 px-5 text-sm font-bold border-b-2 transition cursor-pointer flex items-center gap-2 ${
            initialTab === 'profile'
              ? 'border-rose-600 text-rose-600'
              : 'border-transparent text-gray-500 hover:text-gray-800'
          }`}
        >
          <span>👤</span>
          <span>{isBn ? 'আমার ডোনার প্রোফাইল' : 'My Donor Profile'}</span>
          {selfDonor && (
            <span class="ml-1 text-[11px] px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 font-extrabold">
              {selfDonor.bloodGroup}
            </span>
          )}
        </button>

        <button
          type="button"
          id="tab-btn-referrals"
          role="tab"
          aria-selected={initialTab === 'referrals'}
          aria-controls="panel-referrals"
          class={`tab-btn py-3 px-5 text-sm font-bold border-b-2 transition cursor-pointer flex items-center gap-2 ${
            initialTab === 'referrals'
              ? 'border-rose-600 text-rose-600'
              : 'border-transparent text-gray-500 hover:text-gray-800'
          }`}
        >
          <span>🤝</span>
          <span>{isBn ? 'রেফার করা রক্তদাতাগণ' : 'Referred Donors'}</span>
          <span class="ml-1 text-[11px] px-2 py-0.5 rounded-full bg-gray-200 text-gray-700 font-extrabold">
            {totalReferred}
          </span>
        </button>
      </div>

      <!-- ============================================== -->
      <!-- Tab Panel 1: My Donor Profile -->
      <!-- ============================================== -->
      <section
        id="panel-profile"
        role="tabpanel"
        class={`tab-panel ${initialTab === 'profile' ? '' : 'hidden'}`}
      >
        {selfDonor ? (
          <div class="space-y-6">
            <!-- Active Profile Overview Card -->
            <div class="bg-white rounded-3xl border border-gray-200 shadow-xs p-6 sm:p-8">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6 pb-6 border-b border-gray-100">
                <div class="flex items-center gap-4">
                  <div class="w-16 h-16 rounded-2xl bg-rose-600 text-white flex flex-col items-center justify-center font-extrabold shadow-sm">
                    <span class="text-xs font-semibold leading-none text-rose-200 uppercase">Group</span>
                    <span class="text-2xl leading-none mt-0.5">{selfDonor.bloodGroup}</span>
                  </div>
                  <div>
                    <h2 class="text-xl font-bold text-gray-900">{selfDonor.name}</h2>
                    <p class="text-sm text-gray-600">{selfDonor.phone}</p>
                    {selfDonor.location && (
                      <p class="text-xs text-gray-600 mt-0.5">📍 {selfDonor.location}</p>
                    )}
                  </div>
                </div>

                <!-- Status Badge -->
                <div class="flex flex-col sm:items-end">
                  <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold ${
                    selfCooldown?.status === 'available'
                      ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                      : 'bg-amber-50 text-amber-800 border border-amber-200'
                  }`}>
                    <span>{selfCooldown?.status === 'available' ? '🟢' : '🟡'}</span>
                    <span>
                      {selfCooldown?.status === 'available'
                        ? isBn
                          ? 'রক্তদানে প্রস্তুত (Available)'
                          : 'Available to Donate'
                        : isBn
                          ? 'কুলডাউনে আছেন (Cooling Down)'
                          : 'Cooling Down'}
                    </span>
                  </span>

                  {selfCooldown?.status === 'cooling_down' && (
                    <span class="text-xs text-amber-700 font-semibold mt-1.5">
                      {isBn
                        ? `পরবর্তী সম্ভাব্য রক্তদান: ${formatDate(selfCooldown.nextEligibleDate)} (${selfCooldown.daysRemaining} দিন বাকি)`
                        : `Eligible on: ${formatDate(selfCooldown.nextEligibleDate)} (${selfCooldown.daysRemaining} days left)`}
                    </span>
                  )}
                </div>
              </div>

              <!-- Cooldown Warning Banner if Cooling Down -->
              {selfCooldown?.status === 'cooling_down' && (
                <div class="my-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-xs sm:text-sm flex items-start gap-3">
                  <span class="text-lg">⏳</span>
                  <div class="space-y-1">
                    <p class="font-bold">
                      {isBn ? 'নিরাপদ স্বাস্থ্য বিরতি চলমান রয়েছে' : 'Safe Recovery Period in Effect'}
                    </p>
                    <p class="text-amber-800 leading-relaxed">
                      {isBn ? (
                        <span>
                          আপনার পূর্ববর্তী রক্তদানের ধরন অনুযায়ী (<strong>{selfDonor.donationPreference === 'platelets' ? 'প্লাটিলেট (১৫ দিন)' : 'সম্পূর্ণ রক্ত (৯০ দিন)'}</strong>) নিরাপদ বিরতি সময় পার হওয়ার পর আপনি আগামী <strong>{formatDate(selfCooldown.nextEligibleDate)}</strong> তারিখে পুনরায় রক্তদান করতে পারবেন।
                        </span>
                      ) : (
                        <span>
                          Based on your preference for <strong>{selfDonor.donationPreference === 'platelets' ? 'Platelets (15-day cooldown)' : 'Whole Blood (90-day cooldown)'}</strong>, you will be eligible to donate again on <strong>{formatDate(selfCooldown.nextEligibleDate)}</strong>.
                        </span>
                      )}
                    </p>
                  </div>
                </div>
              )}

              <!-- Profile Details List -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6">
                <div>
                  <span class="block text-xs text-gray-500 font-medium">
                    {isBn ? 'রক্তদানের অগ্রাধিকার' : 'Donation Preference'}
                  </span>
                  <span class="block text-sm font-semibold text-gray-900 mt-1 capitalize">
                    {selfDonor.donationPreference === 'platelets'
                      ? isBn
                        ? 'প্লাটিলেট (SDP)'
                        : 'Platelets (SDP)'
                      : isBn
                        ? 'সম্পূর্ণ রক্ত (Whole Blood)'
                        : 'Whole Blood'}
                  </span>
                </div>

                <div>
                  <span class="block text-xs text-gray-500 font-medium">
                    {isBn ? 'সর্বশেষ রক্তদানের তারিখ' : 'Last Donation Date'}
                  </span>
                  <span class="block text-sm font-semibold text-gray-900 mt-1">
                    {formatDate(selfDonor.lastDonationDate)}
                  </span>
                </div>

                <div>
                  <span class="block text-xs text-gray-500 font-medium">
                    {isBn ? 'পরবর্তী রক্তদানের যোগ্যতা' : 'Next Eligible Date'}
                  </span>
                  <span class="block text-sm font-semibold text-gray-900 mt-1">
                    {selfCooldown?.status === 'cooling_down'
                      ? formatDate(selfCooldown.nextEligibleDate)
                      : isBn
                        ? 'এখনই প্রস্তুত'
                        : 'Eligible Now'}
                  </span>
                </div>
              </div>

              <!-- Action Buttons: Unpublish and Edit Profile -->
              <div class="mt-8 pt-6 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
                <button
                  type="button"
                  id="open-unpublish-self-modal-btn"
                  class="py-2 px-4 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition cursor-pointer"
                >
                  {isBn ? '⚠️ ডোনার তালিকা থেকে নিজেকে প্রত্যাহার করুন' : '⚠️ Unpublish My Donor Profile'}
                </button>

                <button
                  type="button"
                  id="toggle-edit-profile-btn"
                  class="py-2 px-4 rounded-xl border border-gray-300 hover:bg-gray-100 text-gray-700 text-xs font-bold transition cursor-pointer"
                >
                  {isBn ? '✏️ ডোনার তথ্য পরিবর্তন করুন' : '✏️ Edit Donor Info'}
                </button>
              </div>
            </div>

            <!-- Read-Only Donation History Card for Self Donor -->
            <div class="bg-white rounded-3xl border border-gray-200 shadow-xs p-6 sm:p-8">
              <div class="flex items-center justify-between pb-4 border-b border-gray-100">
                <div class="flex items-center gap-2.5">
                  <span class="text-xl">📜</span>
                  <div>
                    <h3 class="text-base font-bold text-gray-900">
                      {isBn ? 'রক্তদানের ইতিহাস ও লগ' : 'Donation History & Logs'}
                    </h3>
                    <p class="text-xs text-gray-500">
                      {isBn ? 'আপনার পূর্ববর্তী রক্তদানের সংরক্ষিত বিবরণ (শুধুমাত্র পাঠযোগ্য)' : 'Verified history of your past donations (read-only)'}
                    </p>
                  </div>
                </div>
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700">
                  {isBn ? `মোট ${selfDonations.length} বার` : `${selfDonations.length} Records`}
                </span>
              </div>

              {selfDonations.length === 0 ? (
                <div class="py-8 text-center text-gray-600">
                  <span class="text-3xl block mb-2" aria-hidden="true">🩸</span>
                  <p class="text-xs font-medium">
                    {isBn ? 'এখনো কোনো রক্তদানের হিস্ট্রি রেকর্ড নেই।' : 'No past donation history recorded yet.'}
                  </p>
                  <p class="text-[11px] text-gray-600 mt-1">
                    {isBn ? 'রক্তদান সম্পন্ন হলে অ্যাডমিন তা যাচাই করে সিস্টেমে লিপিবদ্ধ করবেন।' : 'Once you donate, our admin team will verify and log your donation.'}
                  </p>
                </div>
              ) : (
                <div class="divide-y divide-gray-100 mt-2">
                  {selfDonations.map((item) => {
                    const isPlatelet = (item.donationType || item.type || '').toLowerCase().includes('platelet');
                    return (
                      <div class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div class="space-y-1">
                          <div class="flex items-center gap-2 flex-wrap">
                            <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold ${
                              isPlatelet ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800'
                            }`}>
                              <span aria-hidden="true">{isPlatelet ? '🟡' : '🩸'}</span>
                              <span>{isPlatelet ? (isBn ? 'প্লাটিলেট (SDP)' : 'Platelet (SDP)') : (isBn ? 'সম্পূর্ণ রক্ত (Whole Blood)' : 'Whole Blood')}</span>
                            </span>
                            <span class="text-xs font-mono font-medium text-gray-700">
                              📅 {formatDate(item.donationDate)}
                            </span>
                          </div>
                          {item.hospital && (
                            <p class="text-xs text-gray-600">
                              🏥 <span class="font-medium">{isBn ? 'হাসপাতাল/কেন্দ্র:' : 'Hospital:'}</span> {item.hospital}
                            </p>
                          )}
                          {item.notes && (
                            <p class="text-xs text-gray-600 italic">
                              📝 {item.notes}
                            </p>
                          )}
                        </div>

                        {item.nextEligibleDate && (
                          <div class="text-left sm:text-right shrink-0">
                            <span class="text-[11px] text-gray-600 block">{isBn ? 'পরবর্তী রক্তদান যোগ্যতা:' : 'Next Eligible Date:'}</span>
                            <span class="text-xs font-bold text-emerald-700">{formatDate(item.nextEligibleDate)}</span>
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            <!-- Edit Donor Profile Section (Hidden by default) -->
            <div id="edit-profile-section" class="bg-white rounded-3xl border border-gray-200 shadow-xs p-6 sm:p-8 hidden">
              <h3 class="text-lg font-bold text-gray-900 mb-4 pb-3 border-b border-gray-100">
                {isBn ? 'ডোনার তথ্য আপডেট করুন' : 'Update Donor Profile'}
              </h3>
              <DonorForm
                lang={lang}
                registrationType="self"
                defaultName={selfDonor.name}
                defaultPhone={selfDonor.phone}
                defaultBloodGroup={selfDonor.bloodGroup}
                defaultLocation={selfDonor.location || ''}
                defaultPreference={selfDonor.donationPreference}
                defaultLastDonationDate={
                  selfDonor.lastDonationDate
                    ? new Date(selfDonor.lastDonationDate).toISOString().split('T')[0]
                    : ''
                }
                formId="self-edit-form"
                isUpdate={true}
              />
            </div>
          </div>
        ) : (
          <!-- Not Yet Registered as Donor CTA Card -->
          <div class="bg-white rounded-3xl border border-gray-200 shadow-xs p-6 sm:p-8">
            <div class="max-w-2xl">
              <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-2xl font-bold mb-4">
                🩸
              </div>
              <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900">
                {isBn ? 'রক্তদাতা হিসেবে নিবন্ধন করুন' : 'Register Yourself as a Donor'}
              </h2>
              <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                {isBn
                  ? 'আরাফের চিকিৎসায় নির্দিষ্ট সময় পরপর জরুরি রক্তের প্লাটিলেট ও সম্পূর্ণ রক্ত প্রয়োজন হচ্ছে। আপনি রক্ত বা প্লাটিলেট দান করতে সক্ষম হলে নিচে আপনার রক্তের গ্রুপ ও তথ্য দিয়ে নিজেকে ডোনার হিসেবে তালিকাভুক্ত করুন।'
                  : "Araf urgently requires regular blood and platelet (SDP) transfusions. If you are eligible to donate, please register your donor profile below so our coordination team can reach you when needed."}
              </p>
            </div>

            <div class="mt-8 pt-6 border-t border-gray-100">
              <DonorForm
                lang={lang}
                registrationType="self"
                defaultName={user.name || ''}
                defaultPhone={user.phone || ''}
                formId="self-register-form"
                isUpdate={false}
              />
            </div>
          </div>
        )}
      </section>

      <!-- ============================================== -->
      <!-- Tab Panel 2: Referred Donors -->
      <!-- ============================================== -->
      <section
        id="panel-referrals"
        role="tabpanel"
        class={`tab-panel ${initialTab === 'referrals' ? '' : 'hidden'}`}
      >
        <div class="bg-white rounded-3xl border border-gray-200 shadow-xs p-6 sm:p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-gray-100">
            <div>
              <h2 class="text-xl font-bold text-gray-900">
                {isBn ? 'আমার রেফার করা রক্তদাতাগণ' : 'My Referred Donors'}
              </h2>
              <p class="text-xs sm:text-sm text-gray-500 mt-1">
                {isBn
                  ? 'আপনার পরিচিত যেসকল রক্তদাতাদের আপনি এখানে যুক্ত করেছেন তাদের তালিকা ও বর্তমান কুলডাউন স্ট্যাটাস।'
                  : 'Donors you have registered and referred, along with their live cooldown status.'}
              </p>
            </div>

            <button
              type="button"
              id="open-referral-modal-btn-2"
              class="inline-flex items-center gap-2 py-2 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-xs transition cursor-pointer self-start sm:self-auto"
            >
              <span>➕</span>
              <span>{isBn ? 'নতুন রক্তদাতা যুক্ত করুন' : 'Add Offline Donor'}</span>
            </button>
          </div>

          <!-- Empty State -->
          {referredDonors.length === 0 ? (
            <div class="py-14 text-center">
              <div class="w-16 h-16 rounded-full bg-rose-50 text-rose-500 mx-auto flex items-center justify-center text-2xl font-bold mb-4">
                🤝
              </div>
              <h3 class="text-base font-bold text-gray-900">
                {isBn ? 'এখনও কোনো রক্তদাতা রেফার করেননি' : 'No Referred Donors Yet'}
              </h3>
              <p class="text-xs sm:text-sm text-gray-500 max-w-md mx-auto mt-1 mb-6">
                {isBn
                  ? 'আপনার পরিবার, বন্ধু বা সহকর্মীদের মধ্য থেকে সম্ভাব্য রক্তদাতাদের তথ্য এখানে সংরক্ষণ করুন। প্রয়োজনে জরুরি মুহূর্তে আমাদের টিম তাদের সাথে যোগাযোগ করবে।'
                  : 'Register friends, family, or colleagues who are willing to donate blood or platelets for Araf.'}
              </p>
              <button
                type="button"
                id="open-referral-modal-btn-empty"
                class="inline-flex items-center gap-2 py-2.5 px-5 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-xs transition cursor-pointer"
              >
                <span>➕</span>
                <span>{isBn ? 'প্রথম রক্তদাতা রেফার করুন' : 'Refer Your First Donor'}</span>
              </button>
            </div>
          ) : (
            <!-- Donors Responsive List -->
            <div class="mt-6 overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
                <thead>
                  <tr class="text-xs font-semibold text-gray-500 bg-gray-50/50">
                    <th scope="col" class="py-3 px-4 rounded-l-xl">{isBn ? 'রক্তদাতা' : 'Donor'}</th>
                    <th scope="col" class="py-3 px-4">{isBn ? 'গ্রুপ' : 'Group'}</th>
                    <th scope="col" class="py-3 px-4">{isBn ? 'যোগাযোগ' : 'Contact'}</th>
                    <th scope="col" class="py-3 px-4">{isBn ? 'ধরন' : 'Preference'}</th>
                    <th scope="col" class="py-3 px-4">{isBn ? 'বর্তমান স্ট্যাটাস' : 'Status'}</th>
                    <th scope="col" class="py-3 px-4">{isBn ? 'পরবর্তী রক্তদান' : 'Next Eligible'}</th>
                    <th scope="col" class="py-3 px-4 rounded-r-xl text-right">{isBn ? 'অ্যাকশন' : 'Actions'}</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  {referredDonors.map((d) => (
                    <tr class="hover:bg-gray-50/50 transition">
                      <!-- Name & Location -->
                      <td class="py-4 px-4 font-semibold text-gray-900">
                        <div>{d.name}</div>
                        {d.location && <div class="text-xs text-gray-600 font-normal">📍 {d.location}</div>}
                      </td>

                      <!-- Blood Group -->
                      <td class="py-4 px-4">
                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-extrabold bg-rose-100 text-rose-800">
                          {d.bloodGroup}
                        </span>
                      </td>

                      <!-- Phone Number -->
                      <td class="py-4 px-4 text-xs font-mono text-gray-700">
                        <a href={`tel:${d.phone}`} class="hover:text-rose-600 transition underline underline-offset-2">
                          {d.phone}
                        </a>
                      </td>

                      <!-- Donation Preference -->
                      <td class="py-4 px-4 text-xs capitalize text-gray-600">
                        {d.donationPreference === 'platelets'
                          ? isBn
                            ? 'প্লাটিলেট (১৫ দিন)'
                            : 'Platelets (15d)'
                          : isBn
                            ? 'সম্পূর্ণ রক্ত (৯০ দিন)'
                            : 'Whole Blood (90d)'}
                      </td>

                      <!-- Status Badge -->
                      <td class="py-4 px-4">
                        <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold ${
                          d.computedStatus === 'available'
                            ? 'bg-emerald-100 text-emerald-800'
                            : 'bg-amber-100 text-amber-800'
                        }`}>
                          <span>{d.computedStatus === 'available' ? '🟢' : '🟡'}</span>
                          <span>
                            {d.computedStatus === 'available'
                              ? isBn
                                ? 'প্রস্তুত'
                                : 'Available'
                              : isBn
                                ? `কুলডাউন (${d.daysRemaining} দিন বাকি)`
                                : `Cooling Down (${d.daysRemaining}d left)`}
                          </span>
                        </span>
                      </td>

                      <!-- Next Eligible Date -->
                      <td class="py-4 px-4 text-xs text-gray-600 font-medium">
                        {d.computedStatus === 'cooling_down'
                          ? formatDate(d.nextEligibleDate)
                          : isBn
                            ? 'এখনই প্রস্তুত'
                            : 'Ready Now'}
                      </td>

                      <!-- Actions: History, Edit and Delete -->
                      <td class="py-4 px-4 text-xs text-right whitespace-nowrap">
                        <div class="inline-flex items-center gap-1.5 justify-end">
                          <button
                            type="button"
                            class="view-referred-history-btn px-2.5 py-1 rounded-lg border border-purple-200 bg-purple-50 hover:bg-purple-100 text-purple-700 font-semibold transition cursor-pointer flex items-center gap-1"
                            data-donor-id={d.id}
                            data-name={d.name}
                            title={isBn ? 'ডোনেশন ইতিহাস দেখুন' : 'View donation history'}
                          >
                            <span>📜</span>
                            <span class="hidden sm:inline">{isBn ? 'ইতিহাস' : 'History'}</span>
                            <span class="px-1.5 py-0.2 rounded-full bg-purple-200 text-purple-900 text-[10px] font-bold">
                              {d.historyCount}
                            </span>
                          </button>

                          <button
                            type="button"
                            class="edit-referred-donor-btn px-2.5 py-1 rounded-lg border border-gray-300 hover:bg-gray-100 text-gray-700 font-semibold transition cursor-pointer flex items-center gap-1"
                            data-id={d.id}
                            data-name={d.name}
                            data-phone={d.phone}
                            data-blood-group={d.bloodGroup}
                            data-location={d.location || ''}
                            data-preference={d.donationPreference}
                            data-last-date={d.lastDonationDate ? new Date(d.lastDonationDate).toISOString().split('T')[0] : ''}
                          >
                            <span>✏️</span>
                            <span>{isBn ? 'সম্পাদনা' : 'Edit'}</span>
                          </button>

                          <button
                            type="button"
                            class="delete-referred-donor-btn px-2.5 py-1 rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 font-semibold transition cursor-pointer flex items-center gap-1"
                            data-id={d.id}
                            data-name={d.name}
                          >
                            <span>🗑️</span>
                            <span>{isBn ? 'মুছুন' : 'Delete'}</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </section>
    </main>

    <!-- ============================================== -->
    <!-- Modal 1: Refer Offline Donor (Add New) -->
    <!-- ============================================== -->
    <div
      id="refer-donor-modal"
      class="fixed inset-0 bg-gray-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-refer-headline"
    >
      <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-gray-200 transform transition-all max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-gray-100">
          <div class="flex items-center gap-2.5 text-rose-600">
            <span class="text-xl">🤝</span>
            <h3 id="modal-refer-headline" class="text-lg font-bold text-gray-900">
              {isBn ? 'নতুন রক্তদাতা রেফার করুন' : 'Refer an Offline Donor'}
            </h3>
          </div>
          <button
            type="button"
            id="close-referral-modal-btn"
            aria-label={isBn ? 'রেফারেল ফরম বন্ধ করুন' : 'Close referral modal'}
            class="text-gray-500 hover:text-gray-700 text-xl font-bold w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center transition cursor-pointer"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>

        <p class="text-xs text-gray-600 mb-6">
          {isBn
            ? 'আপনার পরিচিত রক্তদাতার তথ্য প্রদান করুন। জরুরি প্রয়োজনে তাদের সাথে রক্তের গ্রুপের সমন্বয়ে যোগাযোগ করা হবে।'
            : 'Enter the offline donor’s details. They will be added to your referral list with dynamic cooldown tracking.'}
        </p>

        <!-- Embedded Referral Donor Form -->
        <DonorForm
          lang={lang}
          registrationType="referral"
          formId="modal-refer-form"
          isUpdate={false}
        />
      </div>
    </div>

    <!-- ============================================== -->
    <!-- Modal 2: Edit Referred Donor -->
    <!-- ============================================== -->
    <div
      id="edit-referred-modal"
      class="fixed inset-0 bg-gray-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-edit-headline"
    >
      <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-gray-200 transform transition-all max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-gray-100">
          <div class="flex items-center gap-2.5 text-rose-600">
            <span class="text-xl">✏️</span>
            <h3 id="modal-edit-headline" class="text-lg font-bold text-gray-900">
              {isBn ? 'রক্তদাতার তথ্য সম্পাদনা করুন' : 'Edit Referred Donor'}
            </h3>
          </div>
          <button
            type="button"
            id="close-edit-modal-btn"
            aria-label={isBn ? 'সম্পাদনা ফরম বন্ধ করুন' : 'Close edit modal'}
            class="text-gray-500 hover:text-gray-700 text-xl font-bold w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center transition cursor-pointer"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>

        <!-- Edit Form -->
        <form method="POST" action="/api/donor/update" class="space-y-4">
          <input type="hidden" name="type" value="referral" />
          <input type="hidden" name="donor_id" id="edit-donor-id" value="" />

          <!-- Name -->
          <div>
            <label for="edit-name" class="block text-xs font-semibold text-gray-800 mb-1">
              {isBn ? 'পূর্ণ নাম' : 'Full Name'} <span class="text-rose-600">*</span>
            </label>
            <input
              type="text"
              id="edit-name"
              name="name"
              required
              class="block w-full rounded-xl border border-gray-300 py-2 px-3 text-gray-900 text-sm focus:border-rose-500 focus:ring-rose-500 transition"
            />
          </div>

          <!-- Phone -->
          <div>
            <label for="edit-phone" class="block text-xs font-semibold text-gray-800 mb-1">
              {isBn ? 'মোবাইল / হোয়াটসঅ্যাপ নম্বর' : 'Phone / WhatsApp'} <span class="text-rose-600">*</span>
            </label>
            <input
              type="tel"
              id="edit-phone"
              name="phone"
              required
              class="block w-full rounded-xl border border-gray-300 py-2 px-3 text-gray-900 text-sm focus:border-rose-500 focus:ring-rose-500 transition"
            />
          </div>

          <!-- Blood Group & Location -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="edit-blood-group" class="block text-xs font-semibold text-gray-800 mb-1">
                {isBn ? 'রক্তের গ্রুপ' : 'Blood Group'} <span class="text-rose-600">*</span>
              </label>
              <select
                id="edit-blood-group"
                name="blood_group"
                required
                class="block w-full rounded-xl border border-gray-300 py-2 px-3 text-gray-900 text-sm bg-white focus:border-rose-500 focus:ring-rose-500 transition"
              >
                {bloodGroups.map((bg) => (
                  <option value={bg}>{bg}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="edit-location" class="block text-xs font-semibold text-gray-800 mb-1">
                {isBn ? 'এলাকা / শহর' : 'Area / City'}
              </label>
              <input
                type="text"
                id="edit-location"
                name="location"
                class="block w-full rounded-xl border border-gray-300 py-2 px-3 text-gray-900 text-sm focus:border-rose-500 focus:ring-rose-500 transition"
              />
            </div>
          </div>

          <!-- Donation Preference -->
          <div>
            <label for="edit-donation-preference" class="block text-xs font-semibold text-gray-800 mb-1">
              {isBn ? 'রক্তদানের ধরন / অগ্রাধিকার' : 'Donation Preference'} <span class="text-rose-600">*</span>
            </label>
            <select
              id="edit-donation-preference"
              name="donation_preference"
              required
              class="block w-full rounded-xl border border-gray-300 py-2 px-3 text-gray-900 text-sm bg-white focus:border-rose-500 focus:ring-rose-500 transition"
            >
              <option value="whole_blood">
                {isBn ? 'সম্পূর্ণ রক্ত (Whole Blood) — নিরাপদ বিরতি ৯০ দিন' : 'Whole Blood (90d cooldown)'}
              </option>
              <option value="platelets">
                {isBn ? 'প্লাটিলেট / এফারিসিস (Platelets / SDP) — নিরাপদ বিরতি ১৫ দিন' : 'Platelets / SDP (15d cooldown)'}
              </option>
            </select>
          </div>

          <!-- Last Donation Date -->
          <div>
            <label for="edit-last-donation-date" class="block text-xs font-semibold text-gray-800 mb-1">
              {isBn ? 'সর্বশেষ রক্তদানের তারিখ' : 'Last Donation Date'}
            </label>
            <input
              type="date"
              id="edit-last-donation-date"
              name="last_donation_date"
              max={today}
              class="block w-full rounded-xl border border-gray-300 py-2 px-3 text-gray-900 text-sm bg-white focus:border-rose-500 focus:ring-rose-500 transition"
            />
          </div>

          <div class="pt-4 flex items-center justify-end gap-3 border-t border-gray-100">
            <button
              type="button"
              id="cancel-edit-modal-btn"
              class="py-2 px-4 rounded-xl border border-gray-300 bg-white hover:bg-gray-100 text-gray-700 text-xs font-semibold transition cursor-pointer"
            >
              {isBn ? 'বাতিল' : 'Cancel'}
            </button>
            <button
              type="submit"
              class="py-2 px-5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-xs transition cursor-pointer"
            >
              {isBn ? 'পরিবর্তন সংরক্ষণ করুন' : 'Save Changes'}
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- Modal 3: Delete Referred Donor Confirmation -->
    <!-- ============================================== -->
    <div
      id="delete-referred-modal"
      class="fixed inset-0 bg-gray-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-del-referred-headline"
    >
      <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-rose-200">
        <div class="flex items-center gap-3 text-rose-600 mb-4">
          <div class="w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center text-xl font-bold">🗑️</div>
          <h3 id="modal-del-referred-headline" class="text-lg font-bold text-gray-900">
            {isBn ? 'রক্তদাতা অপসারণ' : 'Delete Referred Donor'}
          </h3>
        </div>
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mb-6">
          {isBn ? (
            <span>
              আপনি কি নিশ্চিত যে রক্তদাতা <strong id="delete-donor-name-placeholder" class="text-gray-900"></strong>-কে আপনার রেফারেল তালিকা থেকে স্থায়ীভাবে অপসারণ করতে চান?
            </span>
          ) : (
            <span>
              Are you sure you want to remove <strong id="delete-donor-name-placeholder" class="text-gray-900"></strong> from your referred donors list?
            </span>
          )}
        </p>
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="close-delete-referred-modal-btn"
            class="flex-1 py-2.5 px-4 rounded-xl border border-gray-300 bg-white hover:bg-gray-100 text-gray-700 font-semibold text-sm transition cursor-pointer"
          >
            {isBn ? 'বাতিল' : 'Cancel'}
          </button>
          <form method="POST" action="/api/donor/delete" class="flex-1 m-0">
            <input type="hidden" name="type" value="referral" />
            <input type="hidden" name="donor_id" id="delete-donor-id-input" value="" />
            <button
              type="submit"
              class="w-full py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm shadow-xs transition cursor-pointer"
            >
              {isBn ? 'মুছে ফেলুন' : 'Confirm Delete'}
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- Modal 4: Unpublish Self Donor Confirmation -->
    <!-- ============================================== -->
    <div
      id="unpublish-self-modal"
      class="fixed inset-0 bg-gray-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-unpublish-headline"
    >
      <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-rose-200">
        <div class="flex items-center gap-3 text-rose-600 mb-4">
          <div class="w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center text-xl font-bold">⚠️</div>
          <h3 id="modal-unpublish-headline" class="text-lg font-bold text-gray-900">
            {isBn ? 'ডোনার প্রোফাইল প্রত্যাহার' : 'Unpublish Donor Profile'}
          </h3>
        </div>
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mb-6">
          {isBn
            ? 'আপনি কি রক্তদাতা তালিকা থেকে আপনার ডোনার প্রোফাইল মুছে ফেলতে চান? আপনার মূল অ্যাকাউন্ট ও গুগল লগইন সম্পূর্ণ সক্রিয় ও নিরাপদ থাকবে, তবে রক্তদাতা তালিকা থেকে আপনার রেকর্ডটি প্রত্যাহার করা হবে।'
            : 'Are you sure you want to unpublish your donor profile? Your main user account will remain active, but your profile will be removed from the active donor database.'}
        </p>
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="close-unpublish-self-modal-btn"
            class="flex-1 py-2.5 px-4 rounded-xl border border-gray-300 bg-white hover:bg-gray-100 text-gray-700 font-semibold text-sm transition cursor-pointer"
          >
            {isBn ? 'বাতিল' : 'Cancel'}
          </button>
          <form method="POST" action="/api/donor/delete" class="flex-1 m-0">
            <input type="hidden" name="type" value="self" />
            <button
              type="submit"
              class="w-full py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm shadow-xs transition cursor-pointer"
            >
              {isBn ? 'প্রত্যাহার নিশ্চিত করুন' : 'Confirm Unpublish'}
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- Modal 5: View Referred Donor Donation History (Strictly Read-Only) -->
    <!-- ============================================== -->
    <div
      id="referred-history-modal"
      class="fixed inset-0 bg-gray-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden"
      role="dialog"
      aria-modal="true"
    >
      <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-gray-200 transform transition-all max-h-[85vh] flex flex-col">
        <div class="flex items-center justify-between pb-4 border-b border-gray-100">
          <div class="flex items-center gap-2.5 text-rose-600">
            <span class="text-xl">📜</span>
            <div>
              <h3 id="referred-history-title" class="text-base sm:text-lg font-bold text-gray-900">
                {isBn ? 'রক্তদানের ইতিহাস' : 'Donation History'}
              </h3>
              <p id="referred-history-subtitle" class="text-xs text-gray-600">
                {isBn ? 'সংরক্ষিত রক্তদানের তালিকা (শুধুমাত্র পাঠযোগ্য)' : 'Past recorded donations (Read-only)'}
              </p>
            </div>
          </div>
          <button
            type="button"
            id="close-referred-history-modal-btn"
            aria-label={isBn ? 'ইতিহাস উইন্ডো বন্ধ করুন' : 'Close donation history modal'}
            class="text-gray-500 hover:text-gray-700 text-xl font-bold w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center transition cursor-pointer"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>

        <div id="referred-history-content" class="py-4 space-y-3 overflow-y-auto flex-1">
          <!-- Populated by JavaScript - strictly read-only, NO edit/delete buttons -->
        </div>

        <div class="pt-3 border-t border-gray-100 flex justify-end">
          <button
            type="button"
            id="referred-history-close-btn"
            class="py-2 px-5 rounded-xl bg-gray-900 text-white font-bold text-xs hover:bg-gray-800 transition cursor-pointer"
          >
            {isBn ? 'বন্ধ করুন' : 'Close'}
          </button>
        </div>
      </div>
    </div>

    <!-- Pre-rendered Donations Data Map for Referred Donors -->
    <script id="dashboard-donations-data" type="application/json" set:html={JSON.stringify(Object.fromEntries(donationsByDonorId))} />

    <!-- Client-side Interactive Logic (Tabs, Modals, Populating Edit Values) -->
    <script is:inline>
      (() => {
        // Tab Switching
        const tabBtnProfile = document.getElementById('tab-btn-profile');
        const tabBtnReferrals = document.getElementById('tab-btn-referrals');
        const panelProfile = document.getElementById('panel-profile');
        const panelReferrals = document.getElementById('panel-referrals');

        function switchTab(target) {
          if (target === 'profile') {
            tabBtnProfile?.classList.add('border-rose-600', 'text-rose-600');
            tabBtnProfile?.classList.remove('border-transparent', 'text-gray-500');
            tabBtnProfile?.setAttribute('aria-selected', 'true');

            tabBtnReferrals?.classList.remove('border-rose-600', 'text-rose-600');
            tabBtnReferrals?.classList.add('border-transparent', 'text-gray-500');
            tabBtnReferrals?.setAttribute('aria-selected', 'false');

            panelProfile?.classList.remove('hidden');
            panelReferrals?.classList.add('hidden');
          } else {
            tabBtnReferrals?.classList.add('border-rose-600', 'text-rose-600');
            tabBtnReferrals?.classList.remove('border-transparent', 'text-gray-500');
            tabBtnReferrals?.setAttribute('aria-selected', 'true');

            tabBtnProfile?.classList.remove('border-rose-600', 'text-rose-600');
            tabBtnProfile?.classList.add('border-transparent', 'text-gray-500');
            tabBtnProfile?.setAttribute('aria-selected', 'false');

            panelReferrals?.classList.remove('hidden');
            panelProfile?.classList.add('hidden');
          }
        }

        tabBtnProfile?.addEventListener('click', () => switchTab('profile'));
        tabBtnReferrals?.addEventListener('click', () => switchTab('referrals'));

        // Toggle Edit Self Profile
        const toggleEditBtn = document.getElementById('toggle-edit-profile-btn');
        const editProfileSection = document.getElementById('edit-profile-section');
        toggleEditBtn?.addEventListener('click', () => {
          editProfileSection?.classList.toggle('hidden');
        });

        // 1. Referral Modal (Add New)
        const referModal = document.getElementById('refer-donor-modal');
        const openReferBtns = [
          document.getElementById('open-referral-modal-btn'),
          document.getElementById('open-referral-modal-btn-2'),
          document.getElementById('open-referral-modal-btn-empty'),
        ];
        const closeReferBtn = document.getElementById('close-referral-modal-btn');

        openReferBtns.forEach((btn) => btn?.addEventListener('click', () => referModal?.classList.remove('hidden')));
        closeReferBtn?.addEventListener('click', () => referModal?.classList.add('hidden'));

        // 2. Unpublish Self Modal
        const unpublishModal = document.getElementById('unpublish-self-modal');
        const openUnpublishBtn = document.getElementById('open-unpublish-self-modal-btn');
        const closeUnpublishBtn = document.getElementById('close-unpublish-self-modal-btn');

        openUnpublishBtn?.addEventListener('click', () => unpublishModal?.classList.remove('hidden'));
        closeUnpublishBtn?.addEventListener('click', () => unpublishModal?.classList.add('hidden'));

        // 3. Edit Referred Donor Modal
        const editModal = document.getElementById('edit-referred-modal');
        const closeEditBtn = document.getElementById('close-edit-modal-btn');
        const cancelEditBtn = document.getElementById('cancel-edit-modal-btn');
        const editIdInput = document.getElementById('edit-donor-id');
        const editNameInput = document.getElementById('edit-name');
        const editPhoneInput = document.getElementById('edit-phone');
        const editBloodGroupSelect = document.getElementById('edit-blood-group');
        const editLocationInput = document.getElementById('edit-location');
        const editPreferenceSelect = document.getElementById('edit-donation-preference');
        const editLastDateInput = document.getElementById('edit-last-donation-date');

        document.querySelectorAll('.edit-referred-donor-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            const phone = btn.getAttribute('data-phone');
            const bg = btn.getAttribute('data-blood-group');
            const loc = btn.getAttribute('data-location');
            const pref = btn.getAttribute('data-preference');
            const lastDate = btn.getAttribute('data-last-date');

            if (editIdInput) editIdInput.value = id || '';
            if (editNameInput) editNameInput.value = name || '';
            if (editPhoneInput) editPhoneInput.value = phone || '';
            if (editBloodGroupSelect) editBloodGroupSelect.value = bg || '';
            if (editLocationInput) editLocationInput.value = loc || '';
            if (editPreferenceSelect) editPreferenceSelect.value = pref || 'whole_blood';
            if (editLastDateInput) editLastDateInput.value = lastDate || '';

            editModal?.classList.remove('hidden');
          });
        });

        closeEditBtn?.addEventListener('click', () => editModal?.classList.add('hidden'));
        cancelEditBtn?.addEventListener('click', () => editModal?.classList.add('hidden'));

        // 4. Delete Referred Donor Modal
        const deleteModal = document.getElementById('delete-referred-modal');
        const closeDeleteBtn = document.getElementById('close-delete-referred-modal-btn');
        const deleteDonorIdInput = document.getElementById('delete-donor-id-input');
        const deleteDonorNamePlaceholder = document.getElementById('delete-donor-name-placeholder');

        document.querySelectorAll('.delete-referred-donor-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');

            if (deleteDonorIdInput) deleteDonorIdInput.value = id || '';
            if (deleteDonorNamePlaceholder) deleteDonorNamePlaceholder.textContent = name || '';

            deleteModal?.classList.remove('hidden');
          });
        });

        closeDeleteBtn?.addEventListener('click', () => deleteModal?.classList.add('hidden'));

        // 5. View Referred Donor History Modal (Strictly Read-Only)
        const refHistoryModal = document.getElementById('referred-history-modal');
        const refHistoryTitle = document.getElementById('referred-history-title');
        const refHistorySubtitle = document.getElementById('referred-history-subtitle');
        const refHistoryContent = document.getElementById('referred-history-content');
        const closeRefHistoryBtn = document.getElementById('close-referred-history-modal-btn');
        const closeRefHistoryActionBtn = document.getElementById('referred-history-close-btn');

        let donorHistoryMap = {};
        try {
          const dataEl = document.getElementById('dashboard-donations-data');
          if (dataEl && dataEl.textContent) {
            donorHistoryMap = JSON.parse(dataEl.textContent);
          }
        } catch (e) {
          console.error('Error parsing dashboard donations data:', e);
        }

        document.querySelectorAll('.view-referred-history-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const donorId = btn.getAttribute('data-donor-id');
            const donorName = btn.getAttribute('data-name') || '';
            const list = (donorId && donorHistoryMap[donorId]) || [];

            if (refHistoryTitle) {
              refHistoryTitle.textContent = `${donorName} — ডোনেশন ইতিহাস`;
            }
            if (refHistorySubtitle) {
              refHistorySubtitle.textContent = `সর্বমোট ${list.length}টি রেকর্ড (শুধুমাত্র পাঠযোগ্য)`;
            }

            if (refHistoryContent) {
              if (list.length === 0) {
                refHistoryContent.innerHTML = `
                  <div class="py-8 text-center text-gray-600">
                    <span class="text-3xl block mb-2" aria-hidden="true">🩸</span>
                    <p class="text-xs font-semibold">পূর্বে কোনো রক্তদানের ইতিহাস রেকর্ড নেই।</p>
                  </div>
                `;
              } else {
                refHistoryContent.innerHTML = list
                  .map((item) => {
                    const isPlat = (item.donationType || item.type || '').toLowerCase().includes('platelet');
                    const dDate = item.donationDate ? new Date(item.donationDate).toLocaleDateString('bn-BD', { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A';
                    const nDate = item.nextEligibleDate ? new Date(item.nextEligibleDate).toLocaleDateString('bn-BD', { year: 'numeric', month: 'short', day: 'numeric' }) : '';

                    return `
                      <div class="p-3.5 rounded-2xl bg-gray-50 border border-gray-200 text-xs space-y-1.5">
                        <div class="flex items-center justify-between">
                          <span class="font-bold text-gray-900 flex items-center gap-1.5">
                            <span>${isPlat ? '🟡' : '🩸'}</span>
                            <span>${isPlat ? 'প্লাটিলেট (SDP)' : 'সম্পূর্ণ রক্ত (Whole Blood)'}</span>
                          </span>
                          <span class="font-mono text-gray-500">${dDate}</span>
                        </div>
                        ${item.hospital ? `<p class="text-gray-600">🏥 <strong>স্থান:</strong> ${item.hospital}</p>` : ''}
                        ${item.notes ? `<p class="text-gray-700 bg-white p-2 rounded-xl border border-gray-100">📝 <strong>মন্তব্য:</strong> ${item.notes}</p>` : ''}
                        ${nDate ? `<p class="text-[11px] text-emerald-700 font-semibold">পরবর্তী গ্রহণযোগ্য তারিখ: ${nDate}</p>` : ''}
                      </div>
                    `;
                  })
                  .join('');
              }
            }

            refHistoryModal?.classList.remove('hidden');
          });
        });

        const closeRefHistoryModal = () => refHistoryModal?.classList.add('hidden');
        closeRefHistoryBtn?.addEventListener('click', closeRefHistoryModal);
        closeRefHistoryActionBtn?.addEventListener('click', closeRefHistoryModal);

        // Universal modal backdrop and Escape dismiss
        const allModals = [referModal, unpublishModal, editModal, deleteModal, refHistoryModal];

        allModals.forEach((m) => {
          m?.addEventListener('click', (e) => {
            if (e.target === m) m.classList.add('hidden');
          });
        });

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            allModals.forEach((m) => m?.classList.add('hidden'));
          }
        });
      })();
    </script>

    <!-- Global Footer -->
    <Footer lang={lang} />
  </body>
</html>
